# merged into zynq_pluto_defconfig. Built in, not modules: the plutosdr-fw flow installs no
# kernel modules into the rootfs. A few hundred KB of kernel for every common USB NIC.
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_RTL8152=y
# TUN for IP routing through an application (TETRA packet data: nexus2 attaches to tetra0)
CONFIG_TUN=y
# zstd initramfs (Buildroot BR2_TARGET_ROOTFS_CPIO_ZSTD); the stock defconfig only accepts gzip
CONFIG_RD_ZSTD=y
# Persistent data partition (qspi-data, upper 16 MiB bank): UBI + UBIFS, power-cut safe
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_WL_THRESHOLD=4096
CONFIG_MTD_UBI_BEB_LIMIT=0
CONFIG_UBIFS_FS=y
CONFIG_UBIFS_FS_LZO=y
CONFIG_UBIFS_FS_ZLIB=y
CONFIG_UBIFS_FS_ZSTD=y
# Bluetooth for USB combo adapters (AIC8800D80/D81: aic_load_fw uploads the firmware, the standard
# btusb takes the HCI interface; aic_zlp_quirk hooks usb_submit_urb through a kprobe)
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=y
CONFIG_KPROBES=y
# USB CDC-ACM: Tetra Amp Plus controller (RP2040, /dev/tetra-amp), TETRA radio PEI ports
CONFIG_USB_ACM=y
# WireGuard VPN (S50wireguard, wg-up)
CONFIG_WIREGUARD=y
