# merged into zynq_pluto_defconfig. Built in, not modules: the plutosdr-fw flow installs no
# kernel modules into the rootfs. A few hundred KB of kernel for every common USB NIC.
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_RTL8152=y
# TUN for IP routing through an application (TETRA packet data: nexus2 attaches to tetra0)
CONFIG_TUN=y
# Compression for the 14 MiB stock-flashable FIT: xz kernel (self-decompressing zImage, ARM BCJ
# filter, about 1.4 MB smaller than gzip) and xz initramfs (Buildroot BR2_TARGET_ROOTFS_CPIO_XZ,
# about 1.2 MB smaller than zstd -19, a few seconds more to unpack at boot)
# CONFIG_KERNEL_GZIP is not set
CONFIG_KERNEL_XZ=y
CONFIG_RD_XZ=y
# Persistent data partition (qspi-data, upper 16 MiB bank): UBI + UBIFS, power-cut safe
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_WL_THRESHOLD=4096
CONFIG_MTD_UBI_BEB_LIMIT=0
CONFIG_UBIFS_FS=y
CONFIG_UBIFS_FS_LZO=y
CONFIG_UBIFS_FS_ZLIB=y
CONFIG_UBIFS_FS_ZSTD=y
# Bluetooth for USB combo adapters (AIC8800D80/D81: aic_load_fw uploads the firmware, the standard
# btusb takes the HCI interface; 368b:8d81 gets its ACL zero-length packets from btusb's own quirk
# table, linux patch 0003)
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=y
# AIC8800D80/D81 USB Wi-Fi, built in the kernel tree as modules (firmware/aic8800-intree.sh copies the
# driver to drivers/net/wireless/aic8800): installed with modules_install, depmod's modules.alias lets
# mdev/modprobe load them by modalias when the adapter enumerates; firmware through request_firmware
CONFIG_AIC_WLAN_SUPPORT=y
CONFIG_AIC_LOADFW_SUPPORT=m
CONFIG_AIC8800_WLAN_SUPPORT=m
# Lockup diagnostics: a CPU stuck in the kernel (soft lockup after 2 x kernel.watchdog_thresh, set to
# 4 s by /etc/sysctl.d so it reports before the 10 s hardware watchdog) logs a stack trace; the Pluto
# defconfig already reports tasks blocked in D state for 20 s (DETECT_HUNG_TASK, a hung USB driver).
# Timestamps in the kernel log.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_PRINTK_TIME=y
# USB CDC-ACM: Tetra Amp Plus controller (RP2040, /dev/tetra-amp), TETRA radio PEI ports
CONFIG_USB_ACM=y
# WireGuard VPN (S50wireguard, wg-up)
CONFIG_WIREGUARD=y
# Isolated radio appliance: no hardening that costs time on syscalls and context switches.
# ARM32 ignores mitigations=off/nospectre_v2 (measured on 6.1: "Spectre v2: using BPIALL
# workaround" with both on the command line), so the options go here. The branch predictor
# hardening prompts exist only with EXPERT. Meltdown does not affect the Cortex-A9 (no KPTI).
CONFIG_EXPERT=y
# CONFIG_HARDEN_BRANCH_PREDICTOR is not set
# CONFIG_HARDEN_BRANCH_HISTORY is not set
# CONFIG_CPU_SW_DOMAIN_PAN is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_VMAP_STACK is not set
# CONFIG_HARDENED_USERCOPY is not set
# Size: USB Wi-Fi drivers whose firmware this image does not ship (Ralink rt73/rt2800, Realtek r8712u;
# the Ralink/RTL87xx blobs were dropped) or that only cover 802.11b/g parts from 2004 (rt2500usb)
# CONFIG_RT2X00 is not set
# CONFIG_R8712U is not set
