+
+# RX DMA start sync (ADI v0.39: tdd_channel_1 -> adc_dma/sync, default high).
+# The DMA fifo_wr side runs on sys_cpu_clk here, so the TDD channel (l_clk) is synchronised by
+# the mux, which selects the timestamp packer's block sync while timestamping is enabled.
+ad_ip_instance util_wr_sync_mux tdd_ts_wr_sync_mux
+ad_connect sys_cpu_clk tdd_ts_wr_sync_mux/clk
+ad_connect cpack_timestamp_every_concat/dout tdd_ts_wr_sync_mux/timestamp_every
+ad_connect cpack_timestamp/packed_timestamped_fifo_wr_sync tdd_ts_wr_sync_mux/timestamp_wr_sync_in
+ad_connect axi_tdd_0/tdd_channel_1 tdd_ts_wr_sync_mux/ext_wr_sync_in
+ad_connect tdd_ts_wr_sync_mux/sync_out axi_ad9361_adc_dma/sync
+
+# TX DMA start sync (ADI v0.39: tdd_channel_2 -> dac_dma/sync, default high). m_axis runs on
+# sys_cpu_clk here: same synchroniser, timestamp input unused (timestamp_every tied to 0).
+ad_ip_instance xlconstant tdd_dac_sync_zero
+ad_ip_parameter tdd_dac_sync_zero CONFIG.CONST_WIDTH 32
+ad_ip_parameter tdd_dac_sync_zero CONFIG.CONST_VAL 0
+ad_ip_instance util_wr_sync_mux tdd_dac_sync_cdc
+ad_connect sys_cpu_clk tdd_dac_sync_cdc/clk
+ad_connect tdd_dac_sync_zero/dout tdd_dac_sync_cdc/timestamp_every
+ad_connect GND tdd_dac_sync_cdc/timestamp_wr_sync_in
+ad_connect axi_tdd_0/tdd_channel_2 tdd_dac_sync_cdc/ext_wr_sync_in
+ad_connect tdd_dac_sync_cdc/sync_out axi_ad9361_dac_dma/sync
 
