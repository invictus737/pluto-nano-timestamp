+/*
+ * The firmware stopped answering commands (command manager crashed): nothing the driver sends will
+ * be acknowledged any more. Reset the USB device once through the USB core (the driver is unbound,
+ * the device reset or re-enumerated and the drivers bound again), the standard recovery for a wedged
+ * USB function. A device that no longer answers at all is logically disconnected by the core.
+ */
+void aicwf_usb_recover(struct aic_usb_dev *usb_dev)
+{
+	if (!usb_dev || !usb_dev->intf || usb_dev->state == USB_DOWN_ST ||
+	    test_and_set_bit(0, &usb_dev->recovery))
+		return;
+	dev_err(&usb_dev->intf->dev, "firmware stopped answering commands, resetting the USB device\n");
+	usb_queue_reset_device(usb_dev->intf);
+}
