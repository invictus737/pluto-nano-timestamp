index 0000000..f9375f1
--- /dev/null
+++ b/test/localts_mock_test.cpp
@@ -0,0 +1,270 @@
+// Behaviour test of PlutoSDR_LocalTS against a model of libiio 0.26's mmap ("high speed") local
+// buffers: get_buffer enqueues the block handed out last, then dequeues the next one; in
+// non-blocking mode the dequeue may return -EAGAIN after the enqueue already happened.
+// The model checks that a block is never enqueued twice and never written while the DMA owns it.
+#include <cassert>
+#include <cerrno>
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <map>
+#include <string>
+#include <vector>
+
+#include <iio.h>
+#include <SoapySDR/Logger.h>
+#include <SoapySDR/Time.hpp>
+#include <SoapySDR/Errors.h>
+#include <SoapySDR/Constants.h>
+
+#include "../PlutoSDR_LocalTS.hpp"
+
+static int failures = 0;
+#define CHECK(c) do { if (!(c)) { std::printf("FAIL %s:%d %s\n", __FILE__, __LINE__, #c); failures++; } } while (0)
+
+// ---------------- SoapySDR runtime stubs
+static int warnings = 0;
+extern "C" void SoapySDR_vlogf(const SoapySDRLogLevel lvl, const char *fmt, va_list ap)
+{
+	if (lvl <= SOAPY_SDR_WARNING) warnings++;
+	std::printf("  [log %d] ", (int)lvl); std::vprintf(fmt, ap); std::printf("\n");
+}
+extern "C" long long SoapySDR_ticksToTimeNs(const long long ticks, const double rate) { return (long long)(ticks * 1e9 / rate + 0.5); }
+extern "C" long long SoapySDR_timeNsToTicks(const long long timeNs, const double rate) { return (long long)(timeNs * rate / 1e9 + 0.5); }
+
+// ---------------- libiio model
+struct iio_channel { int idx; bool enabled; };
+struct Block { std::vector<uint8_t> data; enum { KERNEL, USER } owner = KERNEL; std::vector<uint8_t> snapshot; };
+struct iio_device {
+	bool tx; iio_channel ch[4]; unsigned kbuf = 4; uint32_t reg_bc = 0; uint32_t reg_rejects = 0;
+	bool open = false; int fail_create_errno = 0; int fail_next_io = 0;
+	std::vector<Block> blocks; size_t block_bytes = 0;
+	std::deque<int> incoming, outgoing;	// RX: incoming=kernel to fill, outgoing=filled; TX: incoming=queued for DAC, outgoing=free
+	int held = -1;
+	int enqueues = 0;
+	std::vector<std::vector<uint8_t>> transmitted;	// TX: blocks the "DAC" consumed
+	uint64_t next_rx_ts = 0; uint32_t rx_payload_samples = 0;
+};
+struct iio_buffer { iio_device *dev; bool blocking = true; void *start = nullptr; };
+
+static iio_device g_rx, g_tx;
+
+extern "C" {
+unsigned int iio_device_get_channels_count(const iio_device *) { return 4; }
+iio_channel *iio_device_get_channel(const iio_device *d, unsigned int i) { return i < 4 ? (iio_channel *)&d->ch[i] : nullptr; }
+iio_channel *iio_device_find_channel(const iio_device *d, const char *, bool) { return (iio_channel *)&d->ch[0]; }
+void iio_channel_enable(iio_channel *c) { c->enabled = true; }
+void iio_channel_disable(iio_channel *c) { c->enabled = false; }
+int iio_channel_attr_read_longlong(const iio_channel *, const char *, long long *v) { *v = 200000; return 0; }
+void iio_channel_convert(const iio_channel *, void *dst, const void *src) { std::memcpy(dst, src, 2); }
+void iio_channel_convert_inverse(const iio_channel *, void *dst, const void *src) { std::memcpy(dst, src, 2); }
+int iio_device_reg_read(iio_device *d, uint32_t a, uint32_t *v) { *v = a == 0x800000B8 ? d->reg_rejects : d->reg_bc; return 0; }
+int iio_device_reg_write(iio_device *d, uint32_t, uint32_t v) { d->reg_bc = v; return 0; }
+int iio_device_set_kernel_buffers_count(const iio_device *d, unsigned int n) { ((iio_device *)d)->kbuf = n; return 0; }
+
+static int dequeue(iio_buffer *b)
+{
+	iio_device *d = b->dev;
+	if (d->outgoing.empty()) return -EAGAIN;
+	int id = d->outgoing.front(); d->outgoing.pop_front();
+	d->blocks[id].owner = Block::USER; d->held = id; b->start = d->blocks[id].data.data();
+	return 0;
+}
+static void enqueue_held(iio_buffer *b)
+{
+	iio_device *d = b->dev; int id = d->held; assert(id >= 0);
+	assert(d->blocks[id].owner == Block::USER);			// never enqueued twice
+	d->blocks[id].owner = Block::KERNEL; d->blocks[id].snapshot = d->blocks[id].data;
+	d->incoming.push_back(id); d->held = -1; d->enqueues++;
+}
+
+iio_buffer *iio_device_create_buffer(const iio_device *cd, size_t samples, bool)
+{
+	iio_device *d = (iio_device *)cd;
+	if (d->fail_create_errno) { errno = d->fail_create_errno; d->fail_create_errno = 0; return nullptr; }
+	if (d->open) { errno = EBUSY; return nullptr; }
+	d->open = true; d->block_bytes = samples * 4; d->blocks.assign(d->kbuf, Block{});
+	d->incoming.clear(); d->outgoing.clear(); d->held = -1;
+	for (unsigned i = 0; i < d->kbuf; i++) { d->blocks[i].data.assign(d->block_bytes, 0xEE); (d->tx ? d->outgoing : d->incoming).push_back(i); }
+	iio_buffer *b = new iio_buffer{d};
+	if (d->tx) { int r = dequeue(b); assert(r == 0); }
+	return b;
+}
+void iio_buffer_destroy(iio_buffer *b) { b->dev->open = false; b->dev->held = -1; delete b; }
+int iio_buffer_set_blocking_mode(iio_buffer *b, bool blocking) { b->blocking = blocking; return 0; }
+int iio_buffer_get_poll_fd(iio_buffer *) { return -1; }	// poll() ignores it: plain timeout
+void *iio_buffer_start(const iio_buffer *b) { return b->start; }
+ssize_t iio_buffer_refill(iio_buffer *b)
+{
+	iio_device *d = b->dev;
+	if (d->fail_next_io) { int e = d->fail_next_io; d->fail_next_io = 0; return -e; }
+	if (d->held >= 0) enqueue_held(b);
+	int r = dequeue(b); if (r) return r;
+	return (ssize_t)d->block_bytes;
+}
+ssize_t iio_buffer_push(iio_buffer *b)
+{
+	iio_device *d = b->dev;
+	if (d->fail_next_io) { int e = d->fail_next_io; d->fail_next_io = 0; return -e; }
+	if (d->held >= 0) enqueue_held(b);
+	int r = dequeue(b); if (r) return r;
+	return (ssize_t)d->block_bytes;
+}
+}
+
+// RX "ADC": fill n kernel blocks with header + ramp samples
+static void rx_produce(int n, uint64_t skip = 0)
+{
+	for (int k = 0; k < n && !g_rx.incoming.empty(); k++) {
+		int id = g_rx.incoming.front(); g_rx.incoming.pop_front();
+		g_rx.next_rx_ts += skip; skip = 0;
+		uint8_t *p = g_rx.blocks[id].data.data();
+		std::memcpy(p, &g_rx.next_rx_ts, 8);
+		int16_t *s = (int16_t *)(p + 8);
+		for (uint32_t i = 0; i < g_rx.rx_payload_samples; i++) { s[2 * i] = (int16_t)((g_rx.next_rx_ts + i) & 0x7ff); s[2 * i + 1] = -s[2 * i]; }
+		g_rx.next_rx_ts += g_rx.rx_payload_samples;
+		g_rx.outgoing.push_back(id);
+	}
+}
+// TX "DAC": consume n queued blocks, checking nobody wrote into them after the enqueue
+static void tx_consume(int n)
+{
+	for (int k = 0; k < n && !g_tx.incoming.empty(); k++) {
+		int id = g_tx.incoming.front(); g_tx.incoming.pop_front();
+		CHECK(g_tx.blocks[id].data == g_tx.blocks[id].snapshot);	// not written while DMA-owned
+		g_tx.transmitted.push_back(g_tx.blocks[id].data);
+		g_tx.outgoing.push_back(id);
+	}
+}
+static uint64_t hdr(const std::vector<uint8_t> &b) { uint64_t t; std::memcpy(&t, b.data(), 8); return t; }
+static int16_t smp(const std::vector<uint8_t> &b, size_t i, int c) { int16_t v; std::memcpy(&v, b.data() + 8 + 4 * i + 2 * c, 2); return v; }
+
+int main()
+{
+	const uint32_t N = 100; const SoapySDR::Kwargs args; const std::vector<size_t> ch{0};
+	g_rx.tx = false; g_tx.tx = true; g_rx.rx_payload_samples = N; g_rx.next_rx_ts = 5000;
+
+	std::printf("RX: stopped stream times out, start/stop idempotent\n");
+	{
+		rx_streamer_local_ts rx(&g_rx, PLUTO_SDR_CS16, ch, args, N);
+		CHECK((g_rx.reg_bc >> 1) == 0);	// register written at open, not at setup
+		int16_t buf[2 * 300]; void *bp[1] = {buf}; int flags; long long tns;
+		CHECK((int)rx.recv(bp, 300, flags, tns, 1000) == SOAPY_SDR_TIMEOUT);
+		CHECK(rx.start(0, 0, 0) == 0); CHECK(rx.start(0, 0, 0) == 0);
+		CHECK((g_rx.reg_bc >> 1) == N / 2);	// timestamp_every in 64-bit words
+		CHECK(g_rx.kbuf == 16);
+		CHECK((int)rx.recv(bp, 300, flags, tns, 2000) == SOAPY_SDR_TIMEOUT);	// nothing filled yet
+
+		std::printf("RX: first two blocks discarded, then contiguous blocks with times\n");
+		rx_produce(5);
+		size_t got = rx.recv(bp, 30, flags, tns, 2000);
+		CHECK(got == 30); CHECK(flags & SOAPY_SDR_HAS_TIME);
+		CHECK(tns == SoapySDR::ticksToTimeNs(5200, 200000)); CHECK(buf[0] == (int16_t)(5200 & 0x7ff));
+		got = rx.recv(bp, 300, flags, tns, 2000);
+		CHECK(got == 70); CHECK(tns == SoapySDR::ticksToTimeNs(5230, 200000)); CHECK(buf[0] == (int16_t)(5230 & 0x7ff));
+		got = rx.recv(bp, 300, flags, tns, 2000);
+		CHECK(got == 100); CHECK(tns == SoapySDR::ticksToTimeNs(5300, 200000));
+		CHECK(g_rx.held >= 0);
+
+		std::printf("RX: a gap is reported once and its time is the hardware's\n");
+		int w = warnings;
+		rx_produce(1, 1000);
+		rx.recv(bp, 300, flags, tns, 2000); // block 5400 was produced before the gap
+		got = rx.recv(bp, 300, flags, tns, 2000);
+		CHECK(got == 100); CHECK(tns == SoapySDR::ticksToTimeNs(6500, 200000)); CHECK(warnings == w + 1);
+
+		std::printf("RX: refill error -> reopen, discards again, continues\n");
+		g_rx.fail_next_io = EIO;
+		CHECK((int)rx.recv(bp, 300, flags, tns, 30000) == SOAPY_SDR_TIMEOUT);	// reopened, empty
+		rx_produce(3);
+		got = rx.recv(bp, 300, flags, tns, 2000);
+		CHECK(got == 100); CHECK(tns == SoapySDR::ticksToTimeNs(6800, 200000));
+
+		std::printf("RX: busy device (gadget holds the DMA) -> timeouts until free\n");
+		CHECK(rx.stop(0, 0) == 0); CHECK(rx.stop(0, 0) == 0); CHECK(!g_rx.open);
+		g_rx.fail_create_errno = EBUSY;
+		rx.start(0, 0, 0);
+		CHECK(!g_rx.open);
+		CHECK((int)rx.recv(bp, 300, flags, tns, 2000) == SOAPY_SDR_TIMEOUT);	// reopens on this call
+		CHECK(g_rx.open);
+	}
+	CHECK(!g_rx.open);	// destructor released the DMA
+
+	std::printf("TX: header per block, partial burst padded with silence\n");
+	{
+		tx_streamer_local_ts tx(&g_tx, PLUTO_SDR_CS16, ch, args, N);
+		int16_t s[2 * 250]; for (int i = 0; i < 250; i++) { s[2 * i] = (int16_t)(i + 1); s[2 * i + 1] = (int16_t)-(i + 1); }
+		const void *sp[1] = {s}; int flags = SOAPY_SDR_HAS_TIME;
+		CHECK(tx.send(sp, 250, flags, 0, 1000) == SOAPY_SDR_STREAM_ERROR);	// not activated
+		
+		tx.start(0, 0, 0); tx.start(0, 0, 0);
+		CHECK(g_tx.kbuf == 16);
+		long long t0 = SoapySDR::ticksToTimeNs(10000, 200000);
+		size_t done = 0;
+		while (done < 250) {
+			const void *p[1] = {s + 2 * done}; int f = (done == 0 ? SOAPY_SDR_HAS_TIME : 0) | SOAPY_SDR_END_BURST;
+			int r = tx.send(p, 250 - done, f, t0, 1000); CHECK(r > 0); if (r <= 0) break; done += r;
+		}
+		tx_consume(16);
+		CHECK(g_tx.transmitted.size() == 3);
+		if (g_tx.transmitted.size() == 3) {
+			CHECK(hdr(g_tx.transmitted[0]) == 10000); CHECK(hdr(g_tx.transmitted[1]) == 10100); CHECK(hdr(g_tx.transmitted[2]) == 10200);
+			CHECK(smp(g_tx.transmitted[0], 0, 0) == 1); CHECK(smp(g_tx.transmitted[1], 0, 0) == 101);
+			CHECK(smp(g_tx.transmitted[2], 49, 0) == 250); CHECK(smp(g_tx.transmitted[2], 50, 0) == 0); CHECK(smp(g_tx.transmitted[2], 99, 1) == 0);
+		}
+
+		std::printf("TX: a later time inside a block is filled with silence\n");
+		g_tx.transmitted.clear();
+		const void *p1[1] = {s}; int f = SOAPY_SDR_HAS_TIME;
+		CHECK(tx.send(p1, 40, f, SoapySDR::ticksToTimeNs(20000, 200000), 1000) == 40);
+		f = SOAPY_SDR_HAS_TIME | SOAPY_SDR_END_BURST;
+		CHECK(tx.send(p1, 60, f, SoapySDR::ticksToTimeNs(20050, 200000), 1000) == 50);	// 10 padded, 50 fit
+		tx_consume(16);
+		CHECK(g_tx.transmitted.size() == 1);
+		if (!g_tx.transmitted.empty()) {
+			CHECK(hdr(g_tx.transmitted[0]) == 20000); CHECK(smp(g_tx.transmitted[0], 39, 0) == 40);
+			CHECK(smp(g_tx.transmitted[0], 40, 0) == 0); CHECK(smp(g_tx.transmitted[0], 49, 0) == 0); CHECK(smp(g_tx.transmitted[0], 50, 0) == 1);
+		}
+
+		std::printf("TX: all DMA blocks queued -> push enqueues, dequeue EAGAIN, back-pressure timeout, no loss\n");
+		g_tx.transmitted.clear();
+		int enq0 = g_tx.enqueues; long long t = SoapySDR::ticksToTimeNs(30000, 200000);
+		int sent_blocks = 0; int r = 0;
+		for (int k = 0; k < 40; k++) {
+			const void *p[1] = {s}; int fl = (k == 0 ? SOAPY_SDR_HAS_TIME : 0);
+			r = tx.send(p, N, fl, t, 2000);
+			if (r == SOAPY_SDR_TIMEOUT) break;
+			CHECK(r == (int)N); sent_blocks++;
+		}
+		CHECK(r == SOAPY_SDR_TIMEOUT); CHECK(sent_blocks == 16);	// 16 DMA blocks, the 16th push found no free block
+		CHECK(g_tx.enqueues - enq0 == 16);
+		tx_consume(2);
+		const void *p[1] = {s}; int fl = 0;
+		CHECK(tx.send(p, N, fl, 0, 2000) == (int)N);	// resumes after the DAC freed blocks
+		tx_consume(16);
+		CHECK(g_tx.transmitted.size() == 17);
+		for (size_t k = 0; k < g_tx.transmitted.size(); k++) CHECK(hdr(g_tx.transmitted[k]) == 30000 + 100 * k);
+
+		std::printf("TX: FPGA gate rejections are reported (sampled every 1000 blocks)\n");
+		{
+			int w = warnings; g_tx.reg_rejects += 7;
+			for (int k = 0; k < 1000; k++) { const void *q[1] = {s}; int fl2 = 0; int rr = tx.send(q, N, fl2, 0, 2000); CHECK(rr == (int)N); tx_consume(16); }
+			CHECK(warnings == w + 1);
+			w = warnings;
+			for (int k = 0; k < 1000; k++) { const void *q[1] = {s}; int fl2 = 0; tx.send(q, N, fl2, 0, 2000); tx_consume(16); }
+			CHECK(warnings == w);	// no new rejections, no new log
+		}
+
+		std::printf("TX: push error -> reopen, stream continues\n");
+		g_tx.fail_next_io = EIO;
+		{ const void *q[1] = {s}; int fl2 = SOAPY_SDR_HAS_TIME; CHECK(tx.send(q, N, fl2, SoapySDR::ticksToTimeNs(50000, 200000), 2000) == (int)N); }
+		CHECK(!g_tx.open);
+		{ const void *q[1] = {s}; int fl2 = SOAPY_SDR_HAS_TIME; CHECK(tx.send(q, N, fl2, SoapySDR::ticksToTimeNs(50100, 200000), 2000) == (int)N); }
+		CHECK(g_tx.open);
+		tx.stop(0, 0); tx.stop(0, 0); CHECK(!g_tx.open);
+	}
+
+	std::printf(failures ? "FAILED: %d\n" : "ALL PASS\n", failures);
+	return failures ? 1 : 0;
+}
