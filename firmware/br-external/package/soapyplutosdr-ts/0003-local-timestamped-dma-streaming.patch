+/*******************************************************************
+ * TX
+ ******************************************************************/
+
+tx_streamer_local_ts::tx_streamer_local_ts(const iio_device *_dev, const plutosdrStreamFormat _format,
+										   const std::vector<size_t> &channels, const SoapySDR::Kwargs &args,
+										   uint32_t _timestamp_every):
+	dev(_dev), format(_format), timestamp_every(_timestamp_every), sample_rate(0), buf(nullptr),
+	running(false), have_block(false), filled(0), curr_ts(0), pushes(0), rejections(0), have_rejections(false)
+{
+	if (!dev) throw std::runtime_error("cf-ad9361-dds-core-lpc not found");
+	if (timestamp_every == 0) throw std::runtime_error("local timestamped TX needs timestamp_every");
+	channel_list = enable_channels(dev, channels);
+	sample_size_bytes = channel_list.size() * sizeof(int16_t);
+	timestamp_size_samples = HEADER_BYTES / sample_size_bytes;
+	// 16 blocks, as deployed with the gadget (RX16/TX16): the queue must hold the application's TX
+	// lead (6 ms = 12 blocks of 0.5 ms); a full queue is back-pressure, never a loss
+	kernel_buffers = arg_uint(args, "local_buffers_tx", 16, 2, 64);
+	iio_channel_attr_read_longlong(iio_device_find_channel(dev, "voltage0", true), "sampling_frequency", &sample_rate);
+	direct_copy = (channel_list.size() == 2) && same_endianness(channel_list[0]);
+	if (format == PLUTO_SDR_CS12 && !direct_copy)
+		throw std::runtime_error("CS12 not available with this endianess or channel layout");
+	SoapySDR_logf(SOAPY_SDR_INFO, "Local timestamped TX: %u samples per block, %u DMA blocks, direct copy %d",
+				  timestamp_every, kernel_buffers, (int)direct_copy);
+}
+
+tx_streamer_local_ts::~tx_streamer_local_ts()
+{
+	close_buffer();
+}
+
+uint8_t *tx_streamer_local_ts::block_samples()
+{
+	return (uint8_t *)iio_buffer_start(buf) + HEADER_BYTES;
+}
+
+bool tx_streamer_local_ts::open_buffer()
+{
+	try {
+		SoapyPlutoSDR_TimestampEvery::update_device_timestamp_every(dev, timestamp_every, channel_list.size());
+	} catch (const std::exception &e) {
+		log_open.hit(SOAPY_SDR_ERROR, "TX timestamp setting", e.what());
+		return false;
+	}
+	for (iio_channel *chn : channel_list) iio_channel_enable(chn);
+	iio_device_set_kernel_buffers_count(dev, kernel_buffers);
+	// for an output buffer libiio dequeues the first free block here
+	buf = iio_device_create_buffer(dev, timestamp_every + timestamp_size_samples, false);
+	if (!buf) {
+		int e = errno;
+		log_open.hit(SOAPY_SDR_ERROR, "TX DMA buffer unavailable",
+					 e == EBUSY ? "device busy (an SDR gadget or another program holds the TX DMA; operating_mode=slave?)"
+								: strerror(e));
+		return false;
+	}
+	if (iio_buffer_set_blocking_mode(buf, false) < 0) {
+		log_open.hit(SOAPY_SDR_ERROR, "TX DMA buffer", "cannot set non-blocking mode");
+		close_buffer();
+		return false;
+	}
+	have_block = true;
+	filled = 0;
+	have_rejections = false;
+	check_rejections();	// baseline
+	return true;
+}
+
+void tx_streamer_local_ts::close_buffer()
+{
+	if (buf) iio_buffer_destroy(buf);
+	buf = nullptr;
+	have_block = false;
+	filled = 0;
+}
+
+bool tx_streamer_local_ts::acquire(long timeoutUs)
+{
+	if (buf && have_block) return true;	// fast path, no syscall
+	long long deadline = -1;
+	auto left = [&]() {
+		if (deadline < 0) deadline = now_ns() + (timeoutUs > 0 ? (long long)timeoutUs * 1000 : 0);
+		return left_us(deadline);
+	};
+	for (;;) {
+		if (!buf && !open_buffer()) {
+			sleep_us(left());
+			return false;
+		}
+		if (have_block) return true;
+		// nothing held: this only dequeues (libiio enqueues only a block it handed out)
+		ssize_t r = iio_buffer_push(buf);
+		if (r >= 0) {
+			have_block = true;
+			filled = 0;
+			return true;
+		}
+		if (r == -EAGAIN) {
+			long us = left();
+			if (us <= 0) return false;
+			int rc = wait_fd(iio_buffer_get_poll_fd(buf), POLLIN | POLLOUT, us);
+			if (rc == 0) return false;
+			if (rc > 0) continue;
+			r = -EIO;
+		}
+		log_error.hit(SOAPY_SDR_WARNING, "TX DMA dequeue failed, reopening", strerror((int)-r));
+		close_buffer();
+		long us = left();
+		sleep_us(std::min(us, 10000L));
+		if (us <= 10000) return false;
+	}
+}
+
+void tx_streamer_local_ts::push_block()
+{
+	// DMA blocks are reused: silence the unused tail of a partial block
+	if (filled < timestamp_every)
+		std::memset(block_samples() + filled * sample_size_bytes, 0, (timestamp_every - filled) * sample_size_bytes);
+	filled = 0;
+	// enqueue (the samples belong to the DMA from here on), then try to dequeue the next block
+	ssize_t r = iio_buffer_push(buf);
+	if (++pushes % 1000 == 0) check_rejections();
+	if (r >= 0) {
+		have_block = true;
+		return;
+	}
+	have_block = false;
+	if (r == -EAGAIN) return;	// enqueued; the next block is taken by acquire()
+	log_error.hit(SOAPY_SDR_WARNING, "TX DMA push failed, reopening", strerror((int)-r));
+	close_buffer();
+}
+
+void tx_streamer_local_ts::check_rejections()
+{
+	// DAC timestamp gate: blocks whose header was late, or more than 8 blocks (16 x N/2 bus words)
+	// ahead of the DAC, are dropped by the FPGA and counted here
+	uint32_t v = 0;
+	if (iio_device_reg_read((iio_device *)dev, 0x800000B8, &v) < 0) return;
+	if (have_rejections && v != rejections) {
+		char detail[160];
+		std::snprintf(detail, sizeof(detail),
+					  "%u more blocks dropped by the FPGA gate: late, or stamped more than 8 blocks (%u samples) ahead",
+					  v - rejections, timestamp_every * 8);
+		log_rejected.hit(SOAPY_SDR_WARNING, "TX blocks rejected", detail);
+	}
+	rejections = v;
+	have_rejections = true;
+}
+
+void tx_streamer_local_ts::convert(const void * const *buffs, size_t items)
+{
+	uint8_t *base = block_samples() + filled * sample_size_bytes;
+	if (direct_copy) {
+		// TX samples are MSB aligned (full scale 32768)
+		int16_t *dst = (int16_t *)base;
+		if (format == PLUTO_SDR_CS16) {
+			std::memcpy(dst, buffs[0], 2 * sizeof(int16_t) * items);
+		} else if (format == PLUTO_SDR_CF32) {
+			const float *src = (const float *)buffs[0];
+			for (size_t k = 0; k < items * 2; ++k) dst[k] = (int16_t)(src[k] * 32767.999f);
+		} else if (format == PLUTO_SDR_CS12) {
+			const uint8_t *src = (const uint8_t *)buffs[0];
+			for (size_t k = 0; k < items; ++k) {
+				uint16_t s0 = *src++, s1 = *src++, s2 = *src++;
+				*dst++ = int16_t((s1 << 12) | (s0 << 4));
+				*dst++ = int16_t((s2 << 8) | (s1 & 0xf0));
+			}
+		} else if (format == PLUTO_SDR_CS8) {
+			const int8_t *src = (const int8_t *)buffs[0];
+			for (size_t k = 0; k < items * 2; ++k) dst[k] = int16_t(src[k]) << 8;
+		}
+		return;
+	}
+	int16_t src = 0;
+	for (unsigned int k = 0; k < channel_list.size(); k++) {
+		iio_channel *chn = channel_list[k];
+		uint8_t *dst = base + sizeof(int16_t) * k;
+		unsigned int index = k / 2;
+		for (size_t j = 0; j < items; ++j, dst += sample_size_bytes) {
+			if (format == PLUTO_SDR_CS16) src = ((const int16_t *)buffs[index])[j * 2 + (k % 2)];
+			else if (format == PLUTO_SDR_CF32) src = (int16_t)(((const float *)buffs[index])[j * 2 + (k % 2)] * 32767.999f);
+			else if (format == PLUTO_SDR_CS8) src = (int16_t)(((const int8_t *)buffs[index])[j * 2 + (k % 2)] << 8);
+			iio_channel_convert_inverse(chn, dst, &src);
+		}
+	}
+}
+
+int tx_streamer_local_ts::send(const void * const *buffs, const size_t numElems, int &flags, const long long timeNs,
+							   const long timeoutUs)
+{
+	if (!running) return SOAPY_SDR_STREAM_ERROR;
+
+	const bool has_time = (flags & SOAPY_SDR_HAS_TIME) != 0;
+	const uint64_t t = has_time ? (uint64_t)SoapySDR::timeNsToTicks(timeNs, (double)sample_rate) : 0;
+
+	// a later time inside the block being filled: silence up to it (at most to the end of the block)
+	if (has_time && have_block && filled > 0 && t > curr_ts) {
+		size_t pad = (size_t)std::min<uint64_t>(t - curr_ts, timestamp_every - filled);
+		std::memset(block_samples() + filled * sample_size_bytes, 0, pad * sample_size_bytes);
+		filled += pad;
+		curr_ts += pad;
+		if (filled == timestamp_every) push_block();
+	}
+	if (has_time) {
+		if (t < curr_ts) {
+			char detail[96];
+			std::snprintf(detail, sizeof(detail), "tick %llu after %llu",
+						  (unsigned long long)t, (unsigned long long)curr_ts);
+			log_backwards.hit(SOAPY_SDR_WARNING, "TX time stepped backwards", detail);
+		}
+		curr_ts = t;
+	}
+
+	if (!acquire(timeoutUs)) return SOAPY_SDR_TIMEOUT;
+
+	if (filled == 0) {
+		// header: the tick of the block's first sample; the FPGA holds the block until then
+		uint64_t h = curr_ts;
+		std::memcpy(iio_buffer_start(buf), &h, sizeof(h));
+	}
+	size_t items = std::min(timestamp_every - filled, numElems);
+	convert(buffs, items);
+	filled += items;
+	curr_ts += items;
+
+	if (filled == timestamp_every || ((flags & SOAPY_SDR_END_BURST) && items == numElems)) push_block();
+	return (int)items;
+}
+
+int tx_streamer_local_ts::flush(const long timeoutUs)
+{
+	if (buf && have_block && filled > 0) push_block();
+	return 0;
+}
+
+int tx_streamer_local_ts::start(const int flags, const long long timeNs, const size_t numElems)
+{
+	if (running) return 0;
+	running = true;
+	open_buffer();	// on failure the next send() retries
+	return 0;
+}
+
+int tx_streamer_local_ts::stop(const int flags, const long long timeNs)
+{
+	// queued blocks not yet transmitted are dropped with the buffer, like the gadget's queue
+	running = false;
+	close_buffer();
+	return 0;
+}
+
+size_t tx_streamer_local_ts::get_mtu_size()
+{
+	return timestamp_every;
+}
+
+void tx_streamer_local_ts::set_samplerate(const size_t _samplerate)
+{
+	sample_rate = (long long)_samplerate;
+}
