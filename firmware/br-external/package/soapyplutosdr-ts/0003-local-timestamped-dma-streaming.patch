+#include "PlutoSDR_LocalTS.hpp"
+
+#include <algorithm>
+#include <cerrno>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+
+#include <poll.h>
+#include <time.h>
+
+#include <SoapySDR/Constants.h>
+#include <SoapySDR/Errors.hpp>
+#include <SoapySDR/Logger.hpp>
+#include <SoapySDR/Time.hpp>
+
+#include "PlutoSDR_TimestampEvery.hpp"
+
+namespace
+{
+	const size_t HEADER_BYTES = sizeof(uint64_t);
+
+	long long now_ns()
+	{
+		struct timespec ts;
+		clock_gettime(CLOCK_MONOTONIC, &ts);
+		return (long long)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+	}
+
+	// microseconds left until deadline (never negative)
+	long left_us(long long deadline_ns)
+	{
+		long long d = deadline_ns - now_ns();
+		return d > 0 ? (long)(d / 1000) : 0;
+	}
+
+	void sleep_us(long us)
+	{
+		if (us <= 0) return;
+		struct timespec ts = { us / 1000000, (us % 1000000) * 1000 };
+		while (nanosleep(&ts, &ts) == -1 && errno == EINTR) {}
+	}
+
+	// wait for the DMA buffer fd; > 0 ready, 0 timeout, < 0 error
+	int wait_fd(int fd, short events, long us)
+	{
+		struct pollfd p = { fd, events, 0 };
+		int ms = (int)((us + 999) / 1000);
+		int rc;
+		do { rc = poll(&p, 1, ms); } while (rc < 0 && errno == EINTR);
+		if (rc > 0 && (p.revents & (POLLERR | POLLNVAL))) return -1;
+		return rc;
+	}
+
+	unsigned int arg_uint(const SoapySDR::Kwargs &args, const char *key, unsigned int def,
+						  unsigned int lo, unsigned int hi)
+	{
+		if (args.count(key) == 0) return def;
+		unsigned long v;
+		try { v = std::stoul(args.at(key)); }
+		catch (...) { throw std::runtime_error(std::string("invalid value for ") + key); }
+		if (v < lo || v > hi) throw std::runtime_error(std::string(key) + " out of range");
+		return (unsigned int)v;
+	}
+
+	// one Soapy channel = an I/Q pair of IIO channels; disable the rest of the device
+	std::vector<iio_channel*> enable_channels(const iio_device *dev, const std::vector<size_t> &channels)
+	{
+		const std::vector<size_t> &ids = channels.empty() ? std::vector<size_t>{0} : channels;
+		unsigned int n = iio_device_get_channels_count(dev);
+		for (unsigned int i = 0; i < n; i++) iio_channel_disable(iio_device_get_channel(dev, i));
+		std::vector<iio_channel*> list;
+		for (unsigned int i = 0; i < ids.size() * 2; i++) {
+			iio_channel *chn = iio_device_get_channel(dev, i);
+			if (!chn) throw std::runtime_error("IIO channel missing");
+			iio_channel_enable(chn);
+			list.push_back(chn);
+		}
+		return list;
+	}
+
+	bool same_endianness(iio_channel *chn)
+	{
+		int16_t test_dst, test_src = 0x1234;
+		iio_channel_convert(chn, &test_dst, (const void *)&test_src);
+		return test_src == test_dst;
+	}
+}
+
+void PlutoSDR_LocalTS::RateLog::hit(int level, const char *what, const char *detail)
+{
+	count++;
+	long long now = now_ns();
+	if (reported == 0 || now - last_ns >= 5000000000LL) {
+		SoapySDR_logf((SoapySDRLogLevel)level, "local timestamped stream: %s: %s (%llu in total)",
+					  what, detail, (unsigned long long)count);
+		reported = count;
+		last_ns = now;
+	}
+}
+
+/*******************************************************************
+ * RX
+ ******************************************************************/
+
+rx_streamer_local_ts::rx_streamer_local_ts(const iio_device *_dev, const plutosdrStreamFormat _format,
+										   const std::vector<size_t> &channels, const SoapySDR::Kwargs &args,
+										   uint32_t _timestamp_every):
+	dev(_dev), format(_format), timestamp_every(_timestamp_every), sample_rate(0), buf(nullptr),
+	running(false), payload(nullptr), remaining(0), block_ts(0), have_expected(false), expected_ts(0),
+	discard_blocks(0)
+{
+	if (!dev) throw std::runtime_error("cf-ad9361-lpc not found");
+	if (timestamp_every == 0) throw std::runtime_error("local timestamped RX needs timestamp_every");
+	channel_list = enable_channels(dev, channels);
+	sample_size_bytes = channel_list.size() * sizeof(int16_t);
+	timestamp_size_samples = HEADER_BYTES / sample_size_bytes;
+	// 16 blocks: 16 x timestamp_every samples of slack for a consumer that is not real time
+	kernel_buffers = arg_uint(args, "local_buffers_rx", 16, 2, 64);
+	iio_channel_attr_read_longlong(iio_device_find_channel(dev, "voltage0", false), "sampling_frequency", &sample_rate);
+	direct_copy = (channel_list.size() == 2) && same_endianness(channel_list[0]);
+	if (format == PLUTO_SDR_CS12 && !direct_copy)
+		throw std::runtime_error("CS12 not available with this endianess or channel layout");
+	SoapySDR_logf(SOAPY_SDR_INFO, "Local timestamped RX: %u samples per block, %u DMA blocks, direct copy %d",
+				  timestamp_every, kernel_buffers, (int)direct_copy);
+}
+
+rx_streamer_local_ts::~rx_streamer_local_ts()
+{
+	close_buffer();
+}
+
+bool rx_streamer_local_ts::open_buffer()
+{
+	try {
+		// re-applied at every open: another program (a gadget, a plain stream) may have changed it
+		SoapyPlutoSDR_TimestampEvery::update_device_timestamp_every(dev, timestamp_every, channel_list.size());
+	} catch (const std::exception &e) {
+		log_open.hit(SOAPY_SDR_ERROR, "RX timestamp setting", e.what());
+		return false;
+	}
+	for (iio_channel *chn : channel_list) iio_channel_enable(chn);
+	iio_device_set_kernel_buffers_count(dev, kernel_buffers);
+	buf = iio_device_create_buffer(dev, timestamp_every + timestamp_size_samples, false);
+	if (!buf) {
+		int e = errno;
+		log_open.hit(SOAPY_SDR_ERROR, "RX DMA buffer unavailable",
+					 e == EBUSY ? "device busy (an SDR gadget or another program holds the RX DMA; operating_mode=slave?)"
+								: strerror(e));
+		return false;
+	}
+	if (iio_buffer_set_blocking_mode(buf, false) < 0) {
+		log_open.hit(SOAPY_SDR_ERROR, "RX DMA buffer", "cannot set non-blocking mode");
+		close_buffer();
+		return false;
+	}
+	payload = nullptr;
+	remaining = 0;
+	have_expected = false;
+	discard_blocks = 2;		// the first blocks after a DMA start may predate the request
+	return true;
+}
+
+void rx_streamer_local_ts::close_buffer()
+{
+	if (buf) iio_buffer_destroy(buf);
+	buf = nullptr;
+	payload = nullptr;
+	remaining = 0;
+	have_expected = false;
+}
+
+int rx_streamer_local_ts::acquire(long timeoutUs)
+{
+	// the deadline is computed only when a wait is needed: clock_gettime is a syscall on the A9
+	long long deadline = -1;
+	auto left = [&]() {
+		if (deadline < 0) deadline = now_ns() + (timeoutUs > 0 ? (long long)timeoutUs * 1000 : 0);
+		return left_us(deadline);
+	};
+	const ssize_t block_bytes = (ssize_t)((timestamp_every + timestamp_size_samples) * sample_size_bytes);
+
+	for (;;) {
+		if (!buf && !open_buffer()) {
+			sleep_us(left());
+			return SOAPY_SDR_TIMEOUT;
+		}
+
+		// hands the block we hold back to the DMA (if any), then takes the next filled one
+		ssize_t n = iio_buffer_refill(buf);
+		if (n == -EAGAIN) {
+			long us = left();
+			if (us <= 0) return SOAPY_SDR_TIMEOUT;
+			int rc = wait_fd(iio_buffer_get_poll_fd(buf), POLLIN, us);
+			if (rc == 0) return SOAPY_SDR_TIMEOUT;
+			if (rc > 0) continue;
+			n = -EIO;
+		}
+		if (n != block_bytes) {
+			log_error.hit(SOAPY_SDR_WARNING, "RX DMA refill failed, reopening",
+						  n < 0 ? strerror((int)-n) : "short block");
+			close_buffer();
+			long us = left();
+			sleep_us(std::min(us, 10000L));
+			if (us <= 10000) return SOAPY_SDR_TIMEOUT;
+			continue;
+		}
+
+		const uint8_t *start = (const uint8_t *)iio_buffer_start(buf);
+		uint64_t ts;
+		std::memcpy(&ts, start, sizeof(ts));
+		if (discard_blocks > 0) {
+			discard_blocks--;
+			continue;
+		}
+		if (have_expected && ts != expected_ts) {
+			char detail[96];
+			if (ts > expected_ts && ts - expected_ts <= (uint64_t)sample_rate * 10) {
+				std::snprintf(detail, sizeof(detail), "%llu samples lost (reader too slow, DMA overflow)",
+							  (unsigned long long)(ts - expected_ts));
+				log_gap.hit(SOAPY_SDR_WARNING, "RX gap", detail);
+			} else {
+				std::snprintf(detail, sizeof(detail), "expected tick %llu, got %llu",
+							  (unsigned long long)expected_ts, (unsigned long long)ts);
+				log_reset.hit(SOAPY_SDR_WARNING, "RX timeline restarted", detail);
+			}
+		}
+		have_expected = true;
+		expected_ts = ts + timestamp_every;
+		payload = start + HEADER_BYTES;
+		remaining = timestamp_every;
+		block_ts = ts;
+		return 0;
+	}
+}
+
+void rx_streamer_local_ts::convert(void * const *buffs, size_t items)
+{
+	if (direct_copy) {
+		// single RX, I/Q interleaved, 12 bits LSB aligned (full scale 2048)
+		const int16_t *src_ptr = (const int16_t *)payload;
+		if (format == PLUTO_SDR_CS16) {
+			std::memcpy(buffs[0], src_ptr, 2 * sizeof(int16_t) * items);
+		} else if (format == PLUTO_SDR_CF32) {
+			float *dst = (float *)buffs[0];
+			for (size_t k = 0; k < items * 2; ++k) dst[k] = float(src_ptr[k]) / 2048.0f;
+		} else if (format == PLUTO_SDR_CS12) {
+			uint8_t *dst = (uint8_t *)buffs[0];
+			for (size_t k = 0; k < items; ++k) {
+				int16_t i = *src_ptr++;
+				int16_t q = *src_ptr++;
+				*dst++ = uint8_t(i);
+				*dst++ = uint8_t((q << 4) | ((i >> 8) & 0x0f));
+				*dst++ = uint8_t(q >> 4);
+			}
+		} else if (format == PLUTO_SDR_CS8) {
+			int8_t *dst = (int8_t *)buffs[0];
+			for (size_t k = 0; k < items * 2; ++k) dst[k] = int8_t(src_ptr[k] >> 4);
+		}
+		return;
+	}
+	int16_t conv = 0;
+	for (unsigned int i = 0; i < channel_list.size(); i++) {
+		iio_channel *chn = channel_list[i];
+		const uint8_t *src = payload + sizeof(int16_t) * i;
+		unsigned int index = i / 2;
+		for (size_t j = 0; j < items; ++j, src += sample_size_bytes) {
+			iio_channel_convert(chn, &conv, src);
+			if (format == PLUTO_SDR_CS16) ((int16_t *)buffs[index])[j * 2 + (i % 2)] = conv;
+			else if (format == PLUTO_SDR_CF32) ((float *)buffs[index])[j * 2 + (i % 2)] = float(conv) / 2048.0f;
+			else if (format == PLUTO_SDR_CS8) ((int8_t *)buffs[index])[j * 2 + (i % 2)] = int8_t(conv >> 4);
+		}
+	}
+}
+
+size_t rx_streamer_local_ts::recv(void * const *buffs, const size_t numElems, int &flags, long long &timeNs,
+								  const long timeoutUs)
+{
+	flags = 0;
+	if (!running) {
+		// not activated: behave like an empty stream, without spinning the caller
+		sleep_us(std::min(timeoutUs, 100000L));
+		return SOAPY_SDR_TIMEOUT;
+	}
+	if (remaining == 0) {
+		int rc = acquire(timeoutUs);
+		if (rc != 0) return rc;
+	}
+	size_t items = std::min(remaining, numElems);
+	convert(buffs, items);
+	flags = SOAPY_SDR_HAS_TIME;
+	timeNs = SoapySDR::ticksToTimeNs((long long)block_ts, (double)sample_rate);
+	block_ts += items;
+	payload += items * sample_size_bytes;
+	remaining -= items;
+	return items;
+}
+
+int rx_streamer_local_ts::start(const int flags, const long long timeNs, const size_t numElems)
+{
+	if (running) return 0;
+	running = true;
+	open_buffer();	// on failure the next recv() retries
+	return 0;
+}
+
+int rx_streamer_local_ts::stop(const int flags, const long long timeNs)
+{
+	running = false;
+	close_buffer();
+	return 0;
+}
+
+void rx_streamer_local_ts::set_buffer_size_by_samplerate(const size_t _samplerate)
+{
+	// block size is fixed by timestamp_every; only the tick to time conversion changes
+	sample_rate = (long long)_samplerate;
+}
+
+size_t rx_streamer_local_ts::get_mtu_size()
+{
+	return timestamp_every;
+}
