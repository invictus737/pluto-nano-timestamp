config BR2_PACKAGE_SOAPYSDR
	bool "soapysdr"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  SoapySDR vendor-neutral SDR API (library + SoapySDRUtil).
	  Device modules are loaded with dlopen from
	  /usr/lib/SoapySDR/modules0.8.

	  https://github.com/pothosware/SoapySDR
