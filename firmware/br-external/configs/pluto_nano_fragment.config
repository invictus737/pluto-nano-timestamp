# Network adapters: stock config.txt [WLAN] mechanism (wpa_supplicant, iw), the AIC8800 driver
# (aic8800-intree.sh, in the kernel tree), and Realtek firmware for the drivers built into the kernel: rtlwifi for
# r8188eu/rtl8xxxu/rtl8192cu USB Wi-Fi, rtl_nic for r8152 USB Ethernet (RTL8153/RTL8156 2.5G).
# r8188eu only speaks wext: wpa_supplicant gets both backends, the ifup hook tries nl80211,wext.
BR2_PACKAGE_LINUX_FIRMWARE=y
# BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT61 is not set
# BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT73 is not set
# BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT2XX is not set
BR2_PACKAGE_LINUX_FIRMWARE_RTL_81XX=y
# BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX is not set
# BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX is not set
BR2_PACKAGE_LINUX_FIRMWARE_RTL_815X=y
BR2_PACKAGE_WPA_SUPPLICANT_WEXT=y
# Bluetooth for combo adapters: bluetoothd (S40bluetoothd) with the A2DP/AVRCP audio plugins,
# bluetoothctl, and bluez-alsa (S41bluealsa: A2DP source, SBC; bluealsa-cli, build-fw.sh enables it)
# on the system D-Bus. Pairings persist in /mnt/data/bt/lib (/var/lib/bluetooth). The legacy HCI test
# tools (hcitool, l2ping, rctest, ...) are left out.
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO=y
BR2_PACKAGE_BLUEZ_ALSA=y
# Wi-Fi regulatory database (cfg80211 loads regulatory.db; country from config.txt country_wlan)
BR2_PACKAGE_WIRELESS_REGDB=y
# SFTP server for dropbear (/usr/libexec/sftp-server): OpenSSH 9+ scp uses the SFTP protocol;
# dropbearmulti already carries scp for the legacy protocol (scp -O)
BR2_PACKAGE_GESFTPSERVER=y
# host name sent in DHCP requests and announced by avahi as <hostname>.local (config.txt hostname)
BR2_TARGET_GENERIC_HOSTNAME="plutosdr"
# Persistent data partition /mnt/data (S20data): UBI tools
BR2_PACKAGE_MTD_UBIATTACH=y
BR2_PACKAGE_MTD_UBIFORMAT=y
BR2_PACKAGE_MTD_UBIMKVOL=y
BR2_PACKAGE_MTD_UBIDETACH=y
BR2_PACKAGE_MTD_UBINFO=y
# BR2_PACKAGE_LIBIIO_TESTS is not set
BR2_PACKAGE_USB_MODESWITCH=y
# both CPU cores (S05cpus fixes the inherited maxcpus=1 environment)
# board files, then what the build generates (kernel modules, AIC8800 firmware, btop: work-overlay)
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PLUTO_NANO_PATH)/board/nano/rootfs-overlay $(BR2_EXTERNAL_PLUTO_NANO_PATH)/../work-overlay"

# Whole userland on musl (Bootlin external toolchain, GCC 12+, C++20 capable): smaller libc than
# glibc, one ABI for every binary including the optional application (armv7-unknown-linux-musleabihf).
# The kernel and U-Boot keep the plutosdr-fw Linaro cross compiler; userland ABI is independent.
# BR2_TOOLCHAIN_EXTERNAL_LINARO_ARM is not set
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV7_EABIHF_MUSL_STABLE=y
BR2_cortex_a9=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_FPU_NEON=y
BR2_ARM_EABIHF=y

# Runtime for one SDR application on the Pluto itself (requirement 9): SoapySDR + the timestamp
# SoapyPlutoSDR module, pgreenland's UDP gadget (timestamps over uri=ip:127.0.0.1), system TLS roots,
# NTP time at boot (no RTC) and the nano additions in post-build.sh (mdev rules, init scripts).
BR2_PACKAGE_SOAPYSDR=y
BR2_PACKAGE_SOAPYPLUTOSDR_TS=y
BR2_PACKAGE_SDR_IP_GADGET=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PLUTO_NANO_PATH)/board/nano/busybox.fragment"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/pluto/post-build.sh $(BR2_EXTERNAL_PLUTO_NANO_PATH)/board/nano/post-build.sh"

# Compact image: xz ramdisk (the kernel unpacks it, U-Boot passes it through; xz -9 with CRC32 as the
# kernel requires), no zstd tool/library on the target (nothing uses them). The application is not part of the image; it is uploaded to /mnt/jffs2 separately.
# BR2_TARGET_ROOTFS_CPIO_GZIP is not set
# BR2_TARGET_ROOTFS_CPIO_ZSTD is not set
BR2_TARGET_ROOTFS_CPIO_XZ=y
# BR2_PACKAGE_ZSTD is not set

# WireGuard user space ('wg'; tunnels from wg-quick style files by wg-up/S50wireguard)
BR2_PACKAGE_WIREGUARD_TOOLS=y

# Login: NexusBS 2.0 banner (board/nano/motd) and bash as root's shell; /bin/sh stays busybox
BR2_TARGET_GENERIC_ISSUE="Welcome to NexusBS 2.0"
BR2_PACKAGE_BASH=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
