# Lean image: drop Wi-Fi blobs for adapters nobody plugs into this radio, keep the stock
# config.txt [WLAN] mechanism (wpa_supplicant, iw) and add the AIC8800D80 driver.
# BR2_PACKAGE_LINUX_FIRMWARE is not set
# BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT61 is not set
# BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT73 is not set
# BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT2XX is not set
# BR2_PACKAGE_LINUX_FIRMWARE_RTL_81XX is not set
# BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX is not set
# BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX is not set
# BR2_PACKAGE_LIBIIO_TESTS is not set
BR2_PACKAGE_USB_MODESWITCH=y
# both CPU cores (S05cpus fixes the inherited maxcpus=1 environment)
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PLUTO_NANO_PATH)/board/nano/rootfs-overlay"

# Whole userland on musl (Bootlin external toolchain, GCC 12+, C++20 capable): smaller libc than
# glibc, one ABI for every binary including the optional application (armv7-unknown-linux-musleabihf).
# The kernel and U-Boot keep the plutosdr-fw Linaro cross compiler; userland ABI is independent.
# BR2_TOOLCHAIN_EXTERNAL_LINARO_ARM is not set
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV7_EABIHF_MUSL_STABLE=y
BR2_cortex_a9=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_FPU_NEON=y
BR2_ARM_EABIHF=y
