#!/bin/sh
# Persistent data partition at /mnt/data: UBIFS (power-cut safe, wear levelled) on qspi-data in the
# upper 16 MiB bank of the W25Q256 (0x1A00000, 6 MiB), for configuration and application data (the
# applications themselves live in the qspi-apps slot below it).
# An empty or foreign partition is formatted, but only when Linux demonstrably addresses the upper
# bank (Winbond extended address register readable, data partition not aliased onto the lower
# bank). Otherwise nothing is written and /mnt/data stays an empty directory on the RAM disk.
MNT=/mnt/data
mtd() { grep "\"$1\"" /proc/mtd | cut -d: -f1 | tr -dc 0-9; }
first64k() { dd if=/dev/mtd$1 bs=65536 skip=${2:-0} count=1 2>/dev/null | md5sum | cut -d' ' -f1; }
say() { echo "data: $*"; logger -t data "$*"; }
start() {
	mkdir -p $MNT; grep -q " $MNT " /proc/mounts && return 0
	D=$(mtd qspi-data); L=$(mtd qspi-linux); B=$(mtd qspi-bootcopy); F=$(mtd qspi-fsbl-uboot)
	[ -n "$D" ] && [ -n "$L" ] || { say "no qspi-data partition"; return 0; }
	if dmesg | grep -q "failed to read ear reg"; then say "flash bank register unreadable, upper bank not used"; return 0; fi
	# lower-bank mirror of qspi-data (0x1A00000 - 16 MiB = 0xA00000) is qspi-linux block 128
	FF=ecb99e6ffea7be1e5419350f725da86b  # md5 of an erased 64 KiB block (65536 x 0xFF): erased flash on both sides proves nothing
	if [ "$(first64k $D)" = "$(first64k $L 128)" ] && [ "$(first64k $L 128)" != $FF ] && [ "$(first64k $D 1)" = "$(first64k $L 129)" ]; then say "qspi-data reads the lower bank (aliased), not used"; return 0; fi
	# qspi-bootcopy (0x1000000) is what a reset with EAR=1 boots: keep it equal to the boot loader.
	# Only reached when the upper bank is proven addressable (checks above); the copy is read back.
	if [ -n "$B" ] && [ -n "$F" ] && [ "$(md5sum < /dev/mtd$B)" != "$(md5sum < /dev/mtd$F)" ]; then
		dd if=/dev/mtd$F of=/tmp/bootcopy.$$ 2>/dev/null && flash_unlock /dev/mtd$B > /dev/null 2>&1
		if flashcp /tmp/bootcopy.$$ /dev/mtd$B && [ "$(md5sum < /dev/mtd$B)" = "$(md5sum < /tmp/bootcopy.$$)" ]; then
			say "qspi-bootcopy synced from qspi-fsbl-uboot"
		else
			say "WARNING: qspi-bootcopy differs from qspi-fsbl-uboot and could not be synced (a reset with EAR=1 would not boot)"
		fi
		rm -f /tmp/bootcopy.$$
	fi
	# /mnt/jffs2 (qspi-nvmfs): some factory images (HamGeek Nano) ship it unformatted, so it never
	# mounts; give it an empty JFFS2 once, like the stock `device_format_jffs2`.
	N=$(mtd qspi-nvmfs)
	if [ -n "$N" ] && ! grep -q " /mnt/jffs2 " /proc/mounts; then
		if ! mount -t jffs2 mtd$N /mnt/jffs2 2>/dev/null; then
			flash_erase -j -q /dev/mtd$N 0 0 && mount -t jffs2 mtd$N /mnt/jffs2 && say "qspi-nvmfs was not JFFS2: formatted, /mnt/jffs2 mounted"
		fi
	fi
	if ! ubiattach -m "$D" -d 0 > /dev/null 2>&1; then
		# UBI erase-counter headers ("UBI#") that do not attach here belong to another partition
		# layout (before v0.39-std the data partition started at 0x1100000): never wipe them silently
		if [ "$FORCE_FORMAT" != 1 ] && [ "$(dd if=/dev/mtd$D bs=4 count=1 2>/dev/null)" = "UBI#" ]; then
			say "qspi-data holds UBI data of another layout: not formatted, /mnt/data stays in RAM (back it up, then: /etc/init.d/S21data format)"
			return 0
		fi
		say "formatting qspi-data (mtd$D) as UBI"
		ubiformat /dev/mtd$D -y -q && ubiattach -m "$D" -d 0 > /dev/null || { say "UBI attach failed"; return 1; }
	fi
	n=0; while [ ! -e /dev/ubi0 ] && [ $n -lt 5 ]; do sleep 1; n=$((n+1)); done
	ubinfo -d 0 -N data > /dev/null 2>&1 || ubimkvol /dev/ubi0 -N data -m > /dev/null || { say "ubimkvol failed"; return 1; }
	mount -t ubifs -o noatime ubi0:data $MNT && say "mounted ($(df -h $MNT | awk 'NR==2 {print $4}') free)"
}
case "$1" in
format) umount $MNT 2>/dev/null; ubidetach -d 0 2>/dev/null; FORCE_FORMAT=1; D=$(mtd qspi-data)
	[ -n "$D" ] && ubiformat /dev/mtd$D -y -q && say "qspi-data erased"; start; mkdir -p -m 0700 $MNT/bt/lib $MNT/dropbear $MNT/network ;;
start) start
	# Bluetooth pairing store (/var/lib/bluetooth links here): persistent when the partition is mounted
	# also the persistent SSH host keys (/etc/dropbear links here) and network.json (nexus-net)
	mkdir -p -m 0700 $MNT/bt/lib $MNT/dropbear $MNT/network ;;
stop) umount $MNT 2>/dev/null; ubidetach -d 0 2>/dev/null; true ;;
esac
exit 0
