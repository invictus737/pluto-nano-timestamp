#!/bin/sh
# pgreenland UDP IIO gadget (control 30432, data 30433): timestamped streams for uri=ip:<pluto>
# from the network (slave role only; in the master and light roles NexusBS on the Pluto uses the radio
# directly).
D=/usr/sbin/sdr_ip_gadget
[ -x $D ] || exit 0
case "$1" in
start) R=$(fw_printenv -n operating_mode 2>/dev/null)
       case "$R" in master|light) echo "operating_mode $R: sdr_ip_gadget not started"; exit 0 ;; esac
       start-stop-daemon -S -q -b -m -p /var/run/sdr_ip_gadget.pid -x $D && echo "sdr_ip_gadget started" ;;
stop) start-stop-daemon -K -q -p /var/run/sdr_ip_gadget.pid ;;
restart) $0 stop; sleep 1; $0 start ;;
esac
exit 0
