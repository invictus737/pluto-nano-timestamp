#!/bin/sh
# Optional SDR application built into this firmware under /opt/<name> (fetch-app.sh), with its
# configuration on the persistent partition: /mnt/jffs2/<name>/. It starts only when that
# configuration exists, restarts after any exit (5 s), and logs to /var/log/<name>.log (RAM).
# Disable without removing the configuration: fw_setenv app_autostart 0
# Application slot: the unused tail of the firmware partition (the FIT stays below 16 MiB), written by
# the application's deploy tool, so the application survives reboots and firmware updates without
# being part of the image. Layout at 16 MiB: a 64-byte text header "NXAPP1 <bytes>", then a tar.gz
# with <name>/app.conf and its files. Unpacked into /opt (RAM) at start.
SLOT_SKIP=256   # 64 KiB blocks = 16 MiB
slot_unpack() {
  ls /opt/*/app.conf > /dev/null 2>&1 && return 0
  M=$(grep '"firmware"' /proc/mtd | cut -d: -f1); [ -n "$M" ] || return 0
  set -- $(dd if=/dev/mtdblock${M#mtd} bs=65536 skip=$SLOT_SKIP count=1 2>/dev/null | head -c 64)
  [ "$1" = NXAPP1 ] && [ -n "$2" ] || return 0
  dd if=/dev/mtdblock${M#mtd} bs=65536 skip=$SLOT_SKIP count=$(( ($2 + 64 + 65535) / 65536 )) 2>/dev/null | \
    tail -c +65 | head -c "$2" | tar -xzf - -C /opt && echo "application unpacked from the flash slot"
}
[ "$1" = start ] && slot_unpack
for A in /opt/*/app.conf; do
  [ -f "$A" ] || continue
  NAME= RUN= CONF=; . "$A"
  [ -n "$NAME" ] && [ -n "$RUN" ] || continue
  DIR=/mnt/jffs2/$NAME; PID=/var/run/$NAME.pid; LOG=/var/log/$NAME.log
  case "$1" in
  start)
    [ "$(fw_printenv -n app_autostart 2>/dev/null)" = 0 ] && continue
    [ -f "$DIR/$CONF" ] || { echo "$NAME: no $DIR/$CONF, not started"; continue; }
    ( cd "$DIR" || exit 1
      while :; do
        [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 2000000 ] && mv "$LOG" "$LOG.1"
        echo "--- $(date) start" >> "$LOG"
        sh -c "$RUN" >> "$LOG" 2>&1 < /dev/null
        echo "--- $(date) exit $?" >> "$LOG"; sleep 5
      done ) > /dev/null 2>&1 &
    echo $! > "$PID"; echo "$NAME started (log $LOG)" ;;
  stop)
    [ -f "$PID" ] && kill "$(cat "$PID")" 2>/dev/null; rm -f "$PID"
    pids=$(pidof "$NAME") && kill $pids 2>/dev/null; sleep 3; pids=$(pidof "$NAME") && kill -9 $pids 2>/dev/null
    echo "$NAME stopped" ;;
  esac
done
exit 0
