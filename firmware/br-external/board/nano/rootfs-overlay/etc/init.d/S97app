#!/bin/sh
# SDR applications, persistent on the data partition (S21data, UBIFS): /mnt/data/<name>/app.conf
# with NAME= (process name), RUN= (command line, run in /mnt/data/<name>) and CONF= (configuration
# file that must exist). Applications built into the image under /opt/<name>/app.conf still work;
# their configuration is taken from /mnt/data/<name>/, else /mnt/jffs2/<name>/.
# Each starts only when its configuration exists, restarts after any exit (5 s), and logs to
# /var/log/<name>.log (RAM). Only in the master role (nexus-role master); in the default slave role
# the Pluto is an SDR for NexusBS on another computer and starts nothing.
[ "$1" = start ] && [ "$(fw_printenv -n operating_mode 2>/dev/null || echo slave)" != master ] && \
  { echo "role slave: SDR for an external NexusBS host (nexus-role master to run it here)"; exit 0; }
for A in /mnt/data/*/app.conf /opt/*/app.conf; do
  [ -f "$A" ] || continue
  NAME= RUN= CONF=; . "$A"
  [ -n "$NAME" ] && [ -n "$RUN" ] || continue
  [ -f "/var/run/$NAME.seen" ] && continue; : > "/var/run/$NAME.seen"
  DIR=/mnt/data/$NAME; [ -d "$DIR" ] || DIR=/mnt/jffs2/$NAME
  PID=/var/run/$NAME.pid; LOG=/var/log/$NAME.log
  case "$1" in
  start)
    [ -f "$DIR/$CONF" ] || { echo "$NAME: no $DIR/$CONF, not started"; continue; }
    ( cd "$DIR" || exit 1
      while :; do
        [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 2000000 ] && mv "$LOG" "$LOG.1"
        echo "--- $(date) start" >> "$LOG"
        sh -c "$RUN" >> "$LOG" 2>&1 < /dev/null
        echo "--- $(date) exit $?" >> "$LOG"; sleep 5
      done ) > /dev/null 2>&1 &
    echo $! > "$PID"; echo "$NAME started (log $LOG)" ;;
  stop)
    [ -f "$PID" ] && kill "$(cat "$PID")" 2>/dev/null; rm -f "$PID"
    pids=$(pidof "$NAME") && kill $pids 2>/dev/null; sleep 3; pids=$(pidof "$NAME") && kill -9 $pids 2>/dev/null
    echo "$NAME stopped" ;;
  esac
done
rm -f /var/run/*.seen
exit 0
