+/*
+ * Linux ehci_iaa_watchdog(): a cycle older than CONFIG_USB_EHCI_IAA_WATCHDOG_US ends anyway.
+ * USBSTS.IAA set (IAA without its interrupt) or USBCMD.IAAD clear (doorbell dropped without
+ * IAA) count as lost; IAAD still set counts as late. Critical section held. Returns 1 when it
+ * ended a cycle.
+ */
+uint32_t usbh_ehci_iaa_watchdog(uint8_t busid)
+{
+    struct usbh_bus *bus = &g_usbhost_bus[busid];
+    struct ehci_iaa_state *s = &g_ehci_iaa[busid];
+    struct usbh_ehci_iaa_stats *st = &g_ehci_iaa_stats[busid];
+    uint32_t cmd, sts;
+
+    if (!s->in_progress ||
+        (uint32_t)(usb_ehci_time_us() - s->start_us) < CONFIG_USB_EHCI_IAA_WATCHDOG_US) {
+        return 0;
+    }
+    /* as Linux: USBCMD first, then USBSTS (the controller clears IAAD when it sets IAA) */
+    cmd = EHCI_HCOR->usbcmd;
+    sts = EHCI_HCOR->usbsts;
+    st->last_cmd = cmd;
+    st->last_sts = sts;
+    st->last_async = EHCI_HCOR->asynclistaddr;
+    if ((sts & EHCI_USBSTS_IAA) || !(cmd & EHCI_USBCMD_IAAD)) {
+        st->lost++;
+        EHCI_HCOR->usbsts = EHCI_USBSTS_IAA;
+    } else {
+        st->late++;
+    }
+    st->watchdog_ends++;
+    ehci_end_iaa_cycle(bus);
+    return 1;
+}
