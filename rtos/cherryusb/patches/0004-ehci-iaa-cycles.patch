+static void ehci_end_iaa_cycle(struct usbh_bus *bus)
+{
+    struct ehci_iaa_state *s = &g_ehci_iaa[bus->hcd.hcd_id];
+    struct usbh_ehci_iaa_stats *st = &g_ehci_iaa_stats[bus->hcd.hcd_id];
+    uint32_t us = usb_ehci_time_us() - s->start_us;
+
+    s->in_progress = false;
+    if (us > st->max_cycle_us) {
+        st->max_cycle_us = us;
+    }
+    ehci_complete_iaa_qhs(bus);
+    /* QHs unlinked during the cycle (or by the completions above) */
+    ehci_start_iaa_cycle(bus);
+}
+
+/* Linux start_iaa_cycle(): one doorbell for every QH waiting; no-op while a cycle runs */
+static void ehci_start_iaa_cycle(struct usbh_bus *bus)
+{
+    struct ehci_iaa_state *s = &g_ehci_iaa[bus->hcd.hcd_id];
+    struct usbh_ehci_iaa_stats *st = &g_ehci_iaa_stats[bus->hcd.hcd_id];
+    bool any = false;
+    uint32_t cmd, sts;
+
+    if (s->in_progress) {
+        return;
+    }
+    for (uint32_t index = 0; index < CONFIG_USB_EHCI_QH_NUM; index++) {
+        struct ehci_qh_hw *qh = &ehci_qh_pool[bus->hcd.hcd_id][index];
+
+        if (qh->remove_in_iaad == EHCI_IAA_WAIT) {
+            qh->remove_in_iaad = EHCI_IAA_CYCLE;
+            any = true;
+        }
+    }
+    if (!any) {
+        return;
+    }
+    cmd = EHCI_HCOR->usbcmd;
+    sts = EHCI_HCOR->usbsts;
+    if ((sts & EHCI_USBSTS_HALTED) || !(cmd & EHCI_USBCMD_RUN) ||
+        (!(cmd & EHCI_USBCMD_ASEN) && !(sts & EHCI_USBSTS_ASS))) {
+        /* the asynchronous schedule does not run: nothing can hold the QHs, no IAA will come */
+        st->not_running++;
+        ehci_complete_iaa_qhs(bus);
+        return;
+    }
+    if (sts & EHCI_USBSTS_IAA) {
+        /* left over (no cycle runs): it must not end the cycle started now */
+        EHCI_HCOR->usbsts = EHCI_USBSTS_IAA;
+        st->stale_iaa++;
+    }
+    if (cmd & EHCI_USBCMD_IAAD) {
+        /* a doorbell the controller has not answered yet (after a watchdog end) */
+        st->iaad_busy++;
+    }
+    /* Linux: "Make sure the unlinks are all visible to the hardware" */
+    ehci_dma_wmb();
+    EHCI_HCOR->usbcmd = cmd | EHCI_USBCMD_IAAD;
+    (void)EHCI_HCOR->usbcmd;
+    s->in_progress = true;
+    s->start_us = usb_ehci_time_us();
+    st->cycles++;
+}
