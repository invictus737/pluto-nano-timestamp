+/* hands back every QH of the cycle that just ended (or of a controller that is not running) */
+static void ehci_complete_iaa_qhs(struct usbh_bus *bus)
+{
+    for (uint32_t index = 0; index < CONFIG_USB_EHCI_QH_NUM; index++) {
+        struct ehci_qh_hw *qh = &ehci_qh_pool[bus->hcd.hcd_id][index];
+        struct usbh_urb *urb = qh->urb;
+
+        if (qh->remove_in_iaad != EHCI_IAA_CYCLE) {
+            continue;
+        }
+        if (urb == NULL) {
+            qh->remove_in_iaad = EHCI_IAA_NONE;
+            continue;
+        }
+        /*
+         * Bulk QHs run with DTC = 0: the overlay holds the data toggle. After a kill or a
+         * transaction error the overlay (now stable: no longer reachable by the controller)
+         * is the truth; packets of a cancelled transfer that were already acknowledged
+         * advanced it, and resubmitting with the old toggle makes the device drop data.
+         */
+        if ((urb->errorcode == -USB_ERR_SHUTDOWN || urb->errorcode == -USB_ERR_IO) &&
+            USB_GET_ENDPOINT_TYPE(urb->ep->bmAttributes) == USB_ENDPOINT_TYPE_BULK) {
+            urb->data_toggle = (qh->hw.overlay.token & QTD_TOKEN_TOGGLE) ? true : false;
+        }
+        ehci_urb_waitup(bus, urb);
+    }
+}
