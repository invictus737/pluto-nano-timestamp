+/*
+ * Thread context, critical section held (the interrupt handler cannot run): drives the IAA
+ * cycles by polling until qh has been handed back. Bounded by the watchdog: a few
+ * microframes normally, CONFIG_USB_EHCI_IAA_WATCHDOG_US (+1 ms) at worst per cycle.
+ */
+static void ehci_iaa_wait_qh(struct usbh_bus *bus, struct ehci_qh_hw *qh)
+{
+    struct ehci_iaa_state *s = &g_ehci_iaa[bus->hcd.hcd_id];
+    struct usbh_ehci_iaa_stats *st = &g_ehci_iaa_stats[bus->hcd.hcd_id];
+
+    st->kill_waits++;
+    while (qh->remove_in_iaad != EHCI_IAA_NONE) {
+        if (!s->in_progress) {
+            ehci_start_iaa_cycle(bus);
+            if (!s->in_progress && qh->remove_in_iaad != EHCI_IAA_NONE) {
+                /* cannot happen: a waiting QH either starts a cycle or is handed back */
+                qh->remove_in_iaad = EHCI_IAA_CYCLE;
+                ehci_complete_iaa_qhs(bus);
+            }
+            continue;
+        }
+        if (EHCI_HCOR->usbsts & EHCI_USBSTS_IAA) {
+            EHCI_HCOR->usbsts = EHCI_USBSTS_IAA;
+            st->polled_ends++;
+            ehci_end_iaa_cycle(bus);
+            continue;
+        }
+        if (usbh_ehci_iaa_watchdog(bus->hcd.hcd_id)) {
+            continue;
+        }
+        if ((uint32_t)(usb_ehci_time_us() - s->start_us) > CONFIG_USB_EHCI_IAA_SPIN_US) {
+            usb_osal_msleep(1);
+        }
+    }
+}
