+static bool ehci_xacterr_restart(struct ehci_qh_hw *qh, struct ehci_qtd_hw *qtd, uint32_t token)
+{
+#ifdef CONFIG_USB_EHCI_XACTERR_RETRIES
+    if (qtd && (token & (QTD_TOKEN_STATUS_HALTED | QTD_TOKEN_STATUS_XACTERR)) ==
+                   (QTD_TOKEN_STATUS_HALTED | QTD_TOKEN_STATUS_XACTERR) &&
+        (token & QTD_TOKEN_CERR_MASK) == 0 &&
+        (token & (QTD_TOKEN_STATUS_BABBLE | QTD_TOKEN_STATUS_DBERR)) == 0 &&
+        qh->xacterrs < CONFIG_USB_EHCI_XACTERR_RETRIES) {
+        uint32_t keep = ~(QTD_TOKEN_STATUS_HALTED | QTD_TOKEN_STATUS_XACTERR | QTD_TOKEN_CERR_MASK);
+        uint32_t set = QTD_TOKEN_STATUS_ACTIVE | ((uint32_t)EHCI_TUNE_CERR << QTD_TOKEN_CERR_SHIFT);
+
+        qh->xacterrs++;
+        g_ehci_xacterr_retries++;
+        qtd->hw.token = (token & keep) | set;
+        ehci_dma_wmb(); /* Linux qh_completions(): qTD before the overlay */
+        qh->hw.overlay.token = (qh->hw.overlay.token & keep) | set;
+        ehci_dma_wmb();
+        return true;
+    }
+#else
+    (void)qh;
+    (void)qtd;
+    (void)token;
+#endif
+    return false;
+}
