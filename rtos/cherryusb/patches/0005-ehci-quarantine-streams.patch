+/* ---- Nexus-BS: timeout diagnostics ---- */
+
+static uint32_t g_ehci_diag_count, g_ehci_diag_last_us;
+
+int usbh_ehci_diag_allowed(void)
+{
+    size_t flags = usb_osal_enter_critical_section();
+    uint32_t now = usb_ehci_time_us();
+    int ok = g_ehci_diag_count < 4 || (uint32_t)(now - g_ehci_diag_last_us) >= 10000000U;
+
+    if (ok) {
+        g_ehci_diag_count++;
+        g_ehci_diag_last_us = now;
+    }
+    usb_osal_leave_critical_section(flags);
+    return ok;
+}
+
+void usbh_ehci_diag_capture(struct usbh_urb *urb, struct usbh_ehci_diag *d)
+{
+    struct usbh_bus *bus = (urb && urb->hport && urb->hport->bus) ? urb->hport->bus : &g_usbhost_bus[0];
+    uint8_t id = bus->hcd.hcd_id;
+    struct ehci_qh_hw *head = &g_async_qh_head[id], *qh = NULL, *it;
+    const struct usbh_ehci_iaa_stats *st = &g_ehci_iaa_stats[id];
+    uint32_t now[9], t;
+    size_t flags;
+    int guard = 0;
+
+    memset(d, 0, sizeof(*d));
+    d->qh_index = -1;
+    flags = usb_osal_enter_critical_section();
+    d->t_us = usb_ehci_time_us();
+    if (urb && urb->hcpriv) {
+        uintptr_t p = (uintptr_t)urb->hcpriv, base = (uintptr_t)&ehci_qh_pool[id][0];
+
+        if (p >= base && p < base + sizeof(ehci_qh_pool[id]) && (p - base) % sizeof(struct ehci_qh_hw) == 0) {
+            qh = (struct ehci_qh_hw *)p;
+            d->qh_index = (int)((p - base) / sizeof(struct ehci_qh_hw));
+        }
+    }
+    if (qh) {
+        struct ehci_qtd_hw *qtd = EHCI_ADDR2QTD(qh->first_qtd);
+
+        d->hlp = qh->hw.hlp;
+        d->epchar = qh->hw.epchar;
+        d->epcap = qh->hw.epcap;
+        d->curr = qh->hw.curr_qtd;
+        d->next = qh->hw.overlay.next_qtd;
+        d->alt = qh->hw.overlay.alt_next_qtd;
+        d->token = qh->hw.overlay.token;
+        d->iaa_state = qh->remove_in_iaad;
+        d->stream = qh->stream;
+        d->stream_open = qh->stream_open;
+        d->quarantine = qh->quarantine;
+        while (qtd && d->nqtd < USBH_EHCI_DIAG_QTDS) {
+            d->qtd_addr[d->nqtd] = EHCI_PTR2ADDR(qtd);
+            d->qtd_token[d->nqtd] = qtd->hw.token;
+            d->nqtd++;
+            qtd = EHCI_ADDR2QTD(qtd->hw.next_qtd);
+        }
+    }
+    for (it = EHCI_ADDR2QH(head->hw.hlp); it && it != head && guard < 64; it = EHCI_ADDR2QH(it->hw.hlp), guard++) {
+        d->ring_len++;
+        if (it == qh) {
+            d->on_ring = 1;
+        }
+    }
+    if (guard >= 64) {
+        d->ring_len = 0xffff; /* not a ring back to the head */
+    }
+    d->usbcmd = EHCI_HCOR->usbcmd;
+    d->usbsts = EHCI_HCOR->usbsts;
+    d->async = EHCI_HCOR->asynclistaddr;
+    d->frindex0 = EHCI_HCOR->frindex;
+    t = usb_ehci_time_us();
+    while ((uint32_t)(usb_ehci_time_us() - t) < 250) {
+    }
+    d->frindex1 = EHCI_HCOR->frindex;
+    d->portsc = EHCI_HCOR->portsc[0];
+    d->pending = usbh_ehci_iaa_pending(id);
+    d->in_progress = g_ehci_iaa[id].in_progress;
+    d->cycle_us = d->in_progress ? usb_ehci_time_us() - g_ehci_iaa[id].start_us :
+                  (g_ehci_iaa[id].busy_valid ? usb_ehci_time_us() - g_ehci_iaa[id].busy_since : 0);
+    ehci_iaa_counters(st, now);
+    for (int i = 0; i < 9; i++) {
+        d->delta[i] = now[i] - st->ok_snap[i];
+    }
+    d->ok_count = st->ok_count;
+    usb_osal_leave_critical_section(flags);
+}
