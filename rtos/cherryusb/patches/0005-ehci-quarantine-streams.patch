+/*
+ * Nexus-BS: result of a retired qTD, as Linux qtd_copy_status(): babble, then transaction or
+ * data buffer errors (-USB_ERR_IO, also when they halted the qTD: CERR exhausted), and only a
+ * halt without any of them is a STALL handshake from the device.
+ */
+static int ehci_qtd_result(uint32_t token)
+{
+    if (token & QTD_TOKEN_STATUS_BABBLE) {
+        return -USB_ERR_BABBLE;
+    }
+    if (token & (QTD_TOKEN_STATUS_DBERR | QTD_TOKEN_STATUS_XACTERR)) {
+        return -USB_ERR_IO;
+    }
+    if (token & QTD_TOKEN_STATUS_HALTED) {
+        return -USB_ERR_STALL;
+    }
+    return 0;
+}
