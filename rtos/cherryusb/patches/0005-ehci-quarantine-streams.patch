+/*
+ * Nexus-BS: bulk IN streams (USBH_EHCI_URB_STREAM), as Linux qh_append_tds() and
+ * qh_completions(). One QH per endpoint stays linked while it has URBs; each URB is one qTD
+ * (<= 16 KiB, so a short packet simply retires it and the controller goes on with the next
+ * URB's qTD: alternate next pointer unused). The chain always ends at an inactive dummy qTD:
+ * an URB is appended by filling the dummy, linking a fresh dummy behind it and activating it
+ * last, so the controller (which re-reads the overlay's next pointer while the overlay is
+ * inactive) never sees a half-built qTD. The data toggle stays in the overlay across URBs.
+ *
+ * Completed qTDs are retired and their URBs completed while the QH stays linked (the
+ * controller has written them back and will not touch them again). When the QH runs empty or
+ * a qTD fails, it is unlinked and goes through an IAA cycle like any other; its dummy and the
+ * URBs still on it are handed back at the end of the cycle (ehci_stream_handback()).
+ */
+static void ehci_stream_complete(struct usbh_urb **done, uint32_t n)
+{
+    for (uint32_t i = 0; i < n; i++) {
+        struct usbh_urb *urb = done[i];
+
+        if (urb->complete) {
+            urb->complete(urb->arg, urb->errorcode < 0 ? urb->errorcode : (int)urb->actual_length);
+        }
+    }
+}
+
+static void ehci_check_stream_qh(struct usbh_bus *bus, struct ehci_qh_hw *qhead, struct ehci_qh_hw *qh)
+{
+    struct usbh_ehci_iaa_stats *st = &g_ehci_iaa_stats[bus->hcd.hcd_id];
+    struct usbh_urb *done[16];
+    uint32_t n;
+    int err;
+    bool idle, toggle;
+
+    do {
+        if (qh->remove_in_iaad != EHCI_IAA_NONE || !qh->stream_open) {
+            return;
+        }
+        n = 0;
+        err = 0;
+        while (n < 16) {
+            struct ehci_qtd_hw *qtd = EHCI_ADDR2QTD(qh->first_qtd);
+            struct usbh_urb *urb;
+            uint32_t token;
+
+            if (qtd == NULL || qtd == qh->dummy) {
+                break;
+            }
+#if defined(CONFIG_USB_EHCI_DESC_DCACHE_ENABLE)
+            usb_dcache_invalidate((uintptr_t)&qtd->hw, CONFIG_USB_EHCI_ALIGN_SIZE);
+#endif
+            token = qtd->hw.token;
+            if (token & QTD_TOKEN_STATUS_ACTIVE) {
+                break;
+            }
+            if (ehci_xacterr_restart(qh, qtd, token)) {
+                break;
+            }
+            urb = qtd->urb;
+            err = ehci_qtd_result(token);
+            urb->actual_length = qtd->length - ((token & QTD_TOKEN_NBYTES_MASK) >> QTD_TOKEN_NBYTES_SHIFT);
+            urb->errorcode = err;
+            urb->hcpriv = NULL;
+            qh->first_qtd = qtd->hw.next_qtd;
+            ehci_qtd_free(bus, qtd);
+            done[n++] = urb;
+            if (err) {
+                if (err == -USB_ERR_STALL || err == -USB_ERR_BABBLE) {
+                    qh->stalled = 1;
+                }
+                break;
+            }
+            qh->xacterrs = 0;
+        }
+        if (n == 0) {
+            return;
+        }
+        idle = EHCI_ADDR2QTD(qh->first_qtd) == qh->dummy;
+        if (err || idle) {
+            /* halted, or nothing left: off the ring; the rest goes back after its IAA */
+            ehci_qh_remove(qhead, qh);
+            qh->stream_open = 0;
+            qh->remove_in_iaad = EHCI_IAA_WAIT;
+            if (err) {
+                st->stream_teardowns++;
+            }
+        }
+        /* exact when the QH is idle or halted (the last completion of this QH), else a hint */
+        toggle = qh->stalled ? false : ((qh->hw.overlay.token & QTD_TOKEN_TOGGLE) ? true : false);
+        for (uint32_t i = 0; i < n; i++) {
+            done[i]->data_toggle = toggle;
+            if (done[i]->errorcode == 0) {
+                ehci_note_success(bus);
+            }
+        }
+        ehci_stream_complete(done, n);
+    } while (n == 16);
+}
+
+/* end of the IAA cycle of an unlinked stream QH: the URBs still on it, then the QH */
+static void ehci_stream_handback(struct usbh_bus *bus, struct ehci_qh_hw *qh)
+{
+    struct usbh_urb *done[CONFIG_USB_EHCI_QTD_NUM];
+    struct ehci_qtd_hw *qtd = EHCI_ADDR2QTD(qh->first_qtd);
+    uint32_t n = 0, curr = qh->hw.curr_qtd & ~0x1fU;
+    bool toggle = qh->stalled ? false : ((qh->hw.overlay.token & QTD_TOKEN_TOGGLE) ? true : false);
+
+    while (qtd && qtd != qh->dummy && n < CONFIG_USB_EHCI_QTD_NUM) {
+        struct usbh_urb *urb = qtd->urb;
+        uint32_t token = qtd->hw.token;
+
+        if (token & QTD_TOKEN_STATUS_ACTIVE) {
+            /* never finished: the overlay holds the progress of the current one */
+            if (EHCI_PTR2ADDR(qtd) == curr) {
+                token = qh->hw.overlay.token;
+            }
+            urb->errorcode = -USB_ERR_SHUTDOWN;
+        } else {
+            urb->errorcode = ehci_qtd_result(token); /* retired after the unlink */
+        }
+        urb->actual_length = qtd->length - ((token & QTD_TOKEN_NBYTES_MASK) >> QTD_TOKEN_NBYTES_SHIFT);
+        urb->data_toggle = toggle;
+        urb->hcpriv = NULL;
+        done[n++] = urb;
+        qtd->urb = NULL;
+        qtd = EHCI_ADDR2QTD(qtd->hw.next_qtd);
+    }
+    qh->remove_in_iaad = EHCI_IAA_NONE;
+    qh->stream_open = 0;
+    ehci_qh_free(bus, qh);
+    ehci_stream_complete(done, n);
+}
+
+static int ehci_stream_submit(struct usbh_bus *bus, struct usbh_urb *urb)
+{
+    struct usbh_ehci_iaa_stats *st = &g_ehci_iaa_stats[bus->hcd.hcd_id];
+    struct ehci_qh_hw *qh = NULL;
+    struct ehci_qtd_hw *qtd, *d;
+    uint32_t len = urb->transfer_buffer_length;
+    uint32_t token;
+    size_t flags;
+
+    token = QTD_TOKEN_STATUS_ACTIVE | QTD_TOKEN_PID_IN | QTD_TOKEN_IOC |
+            ((uint32_t)EHCI_TUNE_CERR << QTD_TOKEN_CERR_SHIFT) |
+            ((uint32_t)len << QTD_TOKEN_NBYTES_SHIFT);
+
+    flags = usb_osal_enter_critical_section();
+    for (uint32_t index = 0; index < CONFIG_USB_EHCI_QH_NUM; index++) {
+        struct ehci_qh_hw *c = &ehci_qh_pool[bus->hcd.hcd_id][index];
+
+        if (c->inuse && c->stream && c->stream_open && c->remove_in_iaad == EHCI_IAA_NONE &&
+            c->hport == urb->hport && c->ep_addr == urb->ep->bEndpointAddress) {
+            qh = c;
+            break;
+        }
+    }
+    if (qh) {
+        /* Linux qh_append_tds(): the new URB goes into the old dummy, a fresh qTD is the dummy */
+        qtd = ehci_qtd_alloc(bus);
+        if (qtd == NULL) {
+            usb_osal_leave_critical_section(flags);
+            return -USB_ERR_NOMEM;
+        }
+        d = qh->dummy;
+        ehci_qtd_fill(qtd, (uintptr_t)urb->transfer_buffer, len, token);
+        memcpy(d->hw.bpl, qtd->hw.bpl, sizeof(d->hw.bpl));
+        d->bufaddr = qtd->bufaddr;
+        d->length = qtd->length;
+        d->urb = urb;
+        d->hw.alt_next_qtd = QTD_LIST_END;
+        d->hw.next_qtd = EHCI_PTR2ADDR(qtd);
+        memset(qtd->hw.bpl, 0, sizeof(qtd->hw.bpl));
+        qtd->hw.token = QTD_TOKEN_STATUS_HALTED;
+        qtd->hw.next_qtd = QTD_LIST_END;
+        qtd->hw.alt_next_qtd = QTD_LIST_END;
+        qtd->bufaddr = 0;
+        qtd->length = 0;
+        qtd->urb = NULL;
+        qh->dummy = qtd;
+        urb->hcpriv = qh;
+        usb_dcache_flush((uintptr_t)urb->transfer_buffer, USB_ALIGN_UP(len, CONFIG_USB_ALIGN_SIZE));
+        ehci_dma_wmb();
+        d->hw.token = token; /* activate last */
+        ehci_dma_wmb();
+        st->stream_appends++;
+        usb_osal_leave_critical_section(flags);
+        return 0;
+    }
+    if (urb->transfer_flags & USBH_EHCI_URB_APPEND_ONLY) {
+        usb_osal_leave_critical_section(flags);
+        return -USB_ERR_BUSY;
+    }
+
+    qh = ehci_qh_alloc(bus);
+    if (qh == NULL) {
+        usb_osal_leave_critical_section(flags);
+        return -USB_ERR_NOMEM;
+    }
+    qtd = ehci_qtd_alloc(bus);
+    d = ehci_qtd_alloc(bus);
+    if (qtd == NULL || d == NULL) {
+        if (qtd) {
+            ehci_qtd_free(bus, qtd);
+        }
+        if (d) {
+            ehci_qtd_free(bus, d);
+        }
+        ehci_qh_free(bus, qh);
+        usb_osal_leave_critical_section(flags);
+        return -USB_ERR_NOMEM;
+    }
+    ehci_qh_fill(qh,
+                 urb->hport->dev_addr,
+                 urb->ep->bEndpointAddress,
+                 USB_GET_ENDPOINT_TYPE(urb->ep->bmAttributes),
+                 USB_GET_MAXPACKETSIZE(urb->ep->wMaxPacketSize),
+                 0,
+                 0,
+                 urb->hport->speed,
+                 urb->hport->parent->hub_addr,
+                 urb->hport->port);
+    ehci_qtd_fill(qtd, (uintptr_t)urb->transfer_buffer, len, token);
+    qtd->urb = urb;
+    qtd->hw.next_qtd = EHCI_PTR2ADDR(d);
+    /* d: inactive dummy as allocated (halted, no next) */
+    qh->hw.curr_qtd = EHCI_PTR2ADDR(qtd);
+    qh->hw.overlay.next_qtd = EHCI_PTR2ADDR(qtd);
+    qh->hw.overlay.alt_next_qtd = QTD_LIST_END;
+    qh->hw.overlay.token = urb->data_toggle ? QTD_TOKEN_TOGGLE : 0;
+    qh->first_qtd = EHCI_PTR2ADDR(qtd);
+    qh->dummy = d;
+    qh->stream = 1;
+    qh->stream_open = 1;
+    qh->hport = urb->hport;
+    qh->ep_addr = urb->ep->bEndpointAddress;
+    urb->hcpriv = qh;
+    usb_dcache_flush((uintptr_t)urb->transfer_buffer, USB_ALIGN_UP(len, CONFIG_USB_ALIGN_SIZE));
+    ehci_qh_add_head(&g_async_qh_head[bus->hcd.hcd_id], qh);
+    ehci_usbcmd_set(EHCI_USBCMD_ASEN);
+    st->stream_creates++;
+    usb_osal_leave_critical_section(flags);
+    return 0;
+}
