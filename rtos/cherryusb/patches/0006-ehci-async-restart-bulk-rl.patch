+ * Nexus-BS: NAK count reload of high-speed bulk QHs. Stock CherryUSB leaves it 0 (NAK counter
+ * not used), Linux qh_make() uses EHCI_TUNE_RL_HS (4).
+ */
+#ifndef CONFIG_USB_EHCI_BULK_RL_HS
+#define CONFIG_USB_EHCI_BULK_RL_HS EHCI_TUNE_RL_HS
+#endif
+/* Nexus-BS: asynchronous engine watchdog (usbh_ehci_async_watchdog()); 0 disables it */
+#ifndef CONFIG_USB_EHCI_ASYNC_KICK_US
+#define CONFIG_USB_EHCI_ASYNC_KICK_US 0
+#endif
 
 struct ehci_iaa_state {
     bool in_progress;
@@ -367,8 +378,8 @@ static void ehci_qh_fill(struct ehci_qh_hw *qh,
 
                 epcap |= QH_EPCAPS_MULT(EHCI_TUNE_MULT_HS);
             } else if (ep_type == USB_ENDPOINT_TYPE_BULK) {
-                /* Nexus-BS: NAK reload as Linux qh_make() (EHCI_TUNE_RL_HS for bulk and control) */
-                epchar |= (EHCI_TUNE_RL_HS << QH_EPCHAR_RL_SHIFT);
+                /* Nexus-BS: NAK reload CONFIG_USB_EHCI_BULK_RL_HS (Linux qh_make(): EHCI_TUNE_RL_HS) */
+                epchar |= ((uint32_t)CONFIG_USB_EHCI_BULK_RL_HS << QH_EPCHAR_RL_SHIFT);
                 epcap |= QH_EPCAPS_MULT(EHCI_TUNE_MULT_HS);
             } else {
                 /* only for interrupt ep */
@@ -1011,6 +1022,168 @@ uint32_t usbh_ehci_iaa_watchdog(uint8_t busid)
     return 1;
