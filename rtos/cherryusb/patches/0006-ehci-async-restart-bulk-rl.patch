 uint32_t usbh_ehci_iaa_pending(uint8_t busid);
 /* critical section held; ends a cycle older than CONFIG_USB_EHCI_IAA_WATCHDOG_US, returns 1 */
 uint32_t usbh_ehci_iaa_watchdog(uint8_t busid);
+/*
+ * critical section held; restarts a parked asynchronous engine (CONFIG_USB_EHCI_ASYNC_KICK_US,
+ * 0 = off), returns 1 when it did
+ */
+uint32_t usbh_ehci_async_watchdog(uint8_t busid);
 /* microsecond clock (wraps), provided by the port glue */
 uint32_t usb_ehci_time_us(void);
 extern volatile uint32_t g_ehci_xacterr_retries;
