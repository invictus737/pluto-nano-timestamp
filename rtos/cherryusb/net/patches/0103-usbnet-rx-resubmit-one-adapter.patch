 void usbh_cdc_ecm_eth_input(uint8_t *buf, uint32_t buflen);
 void usbh_cdc_ecm_rx_thread(CONFIG_USB_OSAL_THREAD_SET_ARGV);
+/* rx thread: link seen up, the receive loop starts; the interrupt endpoint is the caller's from here (Nexus) */
+void usbh_cdc_ecm_linkup(struct usbh_cdc_ecm *cdc_ecm_class);
 
 #ifdef __cplusplus
 }
