USB Ethernet (rtos/cherryusb/net): hot-swap behaviour of the four class drivers.
- rx thread: a failed bulk IN submit with the device still attached (transaction error,
  babble, an ehci-nxp controller recovery) is resubmitted after a 5..200 ms back-off. Before,
  it went back to find_class: connect_status cleared (transmit refused), the link waited for
  again on the interrupt endpoint (CDC: a notification the device never resends, so receive
  died; RTL8152: enable + set_rx_mode + autoneg again, a 2-3 s renegotiation).
- usbh_X_linkup() (net/usbnet.c) when the receive loop starts: from there the interrupt
  endpoint belongs to the glue's link thread, the rx thread never touches it again.
- connect(): -USB_ERR_BUSY while the single static class object serves another adapter
  (a second adapter of the same class cleared the first one's state).
- rtl8152, asix: without a cable the link is read at 2 Hz (was every 128 ms).

diff --git a/class/cdc/usbh_cdc_ecm.c b/class/cdc/usbh_cdc_ecm.c
index 0c64ff1..9bdec54 100644
--- a/class/cdc/usbh_cdc_ecm.c
+++ b/class/cdc/usbh_cdc_ecm.c
@@ -82,6 +82,11 @@ static int usbh_cdc_ecm_connect(struct usbh_hubport *hport, uint8_t intf)
 
     struct usbh_cdc_ecm *cdc_ecm_class = &g_cdc_ecm_class;
 
+    if (cdc_ecm_class->hport != NULL) {
+        /* one static class object: a second adapter would clear the first one's state */
+        USB_LOG_WRN("cdc_ecm: one adapter at a time, interface %u ignored\r\n", intf);
+        return -USB_ERR_BUSY;
+    }
     memset(cdc_ecm_class, 0, sizeof(struct usbh_cdc_ecm));
 
     cdc_ecm_class->hport = hport;
@@ -234,6 +239,7 @@ static int usbh_cdc_ecm_disconnect(struct usbh_hubport *hport, uint8_t intf)
 
 void usbh_cdc_ecm_rx_thread(CONFIG_USB_OSAL_THREAD_SET_ARGV)
 {
+    uint32_t rx_backoff;
     uint32_t g_cdc_ecm_rx_length;
     int ret;
 
@@ -256,13 +262,25 @@ find_class:
         usb_osal_msleep(128);
     }
 
+    usbh_cdc_ecm_linkup(&g_cdc_ecm_class);
     g_cdc_ecm_rx_length = 0;
+    rx_backoff = 0;
     while (1) {
         usbh_bulk_urb_fill(&g_cdc_ecm_class.bulkin_urb, g_cdc_ecm_class.hport, g_cdc_ecm_class.bulkin, g_cdc_ecm_rx_buffer, CONFIG_USBHOST_CDC_ECM_ETH_MAX_SIZE, USB_OSAL_WAITING_FOREVER, NULL, NULL);
         ret = usbh_submit_urb(&g_cdc_ecm_class.bulkin_urb);
         if (ret < 0) {
+            /* a transfer error with the device still attached (XACTERR, babble, a controller
+             * recovery): resubmit after a short back-off. The link state, the chip setup and the
+             * interrupt endpoint stay as they are; only a gone device leaves the loop. */
+            if (g_cdc_ecm_class.hport != NULL && g_cdc_ecm_class.hport->connected) {
+                rx_backoff = rx_backoff ? MIN(rx_backoff * 2U, 200U) : 5U;
+                usb_osal_msleep(rx_backoff);
+                g_cdc_ecm_rx_length = 0;
+                continue;
+            }
             goto find_class;
         }
+        rx_backoff = 0;
 
         g_cdc_ecm_rx_length = g_cdc_ecm_class.bulkin_urb.actual_length;
 
diff --git a/class/cdc/usbh_cdc_ecm.h b/class/cdc/usbh_cdc_ecm.h
index a3ab84a..97d7190 100644
--- a/class/cdc/usbh_cdc_ecm.h
+++ b/class/cdc/usbh_cdc_ecm.h
@@ -42,6 +42,8 @@ uint8_t *usbh_cdc_ecm_get_eth_txbuf(void);
